# Copy to .env and fill in. NEVER commit .env.
NODE_ENV=production
PORT=8080
SITE_URL=https://www.kidle.ir
DB_URL=mongodb://localhost:27017/kidle

# Long random strings (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
SESSION_SECRET=
OTP_SECRET=

# Melipayamak shared-line SMS (https://console.melipayamak.com)
SMS_API_KEY=
SMS_BODY_ID=347717

# ZarinPal
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false

# Minutes that stock stays reserved while a customer is at the payment gateway
RESERVATION_MINUTES=30
