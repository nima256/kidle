    }
    
    .slide-content p {
      font-size: 14px !important;
    }
  }
  
  /* انیمیشن متن */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .slide.active .slide-content {
    animation: fadeInUp 0.8s ease-out;
  }
</style>
