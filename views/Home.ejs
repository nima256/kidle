                  <div>
                    <span class="text-pink-500 font-bold">
                      <%= toPersianDigits(product.offerPrice) %> تومان
                    </span>
                    <span class="text-gray-400 line-through text-sm mr-2">
                      <%= toPersianDigits(product.price) %> تومان
                    </span>
                  </div>
