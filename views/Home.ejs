<script>
  // تابع کمکی برای اطمینان از وجود المنت‌ها
  function waitForElement(selector, callback) {
    if (document.querySelector(selector)) {
      callback();
      return;
    }
    const observer = new MutationObserver(function(mutations) {
      if (document.querySelector(selector)) {
        observer.disconnect();
        callback();
      }
    });
    observer.observe(document.body, { childList: true, subtree: true });
  }
  
  document.addEventListener("DOMContentLoaded", function() {
    // منوی همبرگری موبایل
    var menuBtn = document.getElementById('menu-btn');
    var mobileMenu = document.getElementById('mobile-menu');
    
    if (menuBtn && mobileMenu) {
      menuBtn.onclick = function(e) {
        e.stopPropagation();
        if (mobileMenu.style.display === 'none' || mobileMenu.style.display === '') {
          mobileMenu.style.display = 'flex';
                  document.body.classList.add('menu-open'); // اضافه کنید

        } else {
          mobileMenu.style.display = 'none';
          document.body.classList.remove('menu-open'); // اضافه کنید
        }
      };
    }
    
    // ساب‌منوی موبایل
    var mobileTriggers = document.querySelectorAll('.mobile-dropdown-trigger');
    mobileTriggers.forEach(function(trigger) {
      trigger.onclick = function(e) {
        e.stopPropagation();
        var menu = this.nextElementSibling;
        var icon = this.querySelector('i');
        if (menu.style.display === 'none' || menu.style.display === '') {
          menu.style.display = 'block';
          icon.style.transform = 'rotate(180deg)';
        } else {
          menu.style.display = 'none';
          icon.style.transform = 'rotate(0deg)';
        }
      };
    });
    
    var subTriggers = document.querySelectorAll('.mobile-submenu-trigger');
    subTriggers.forEach(function(trigger) {
      trigger.onclick = function(e) {
        e.stopPropagation();
        var submenu = this.nextElementSibling;
        var icon = this.querySelector('i');
        if (submenu.style.display === 'none' || submenu.style.display === '') {
          submenu.style.display = 'block';
          icon.style.transform = 'rotate(180deg)';
        } else {
          submenu.style.display = 'none';
          icon.style.transform = 'rotate(0deg)';
        }
      };
    });
    
    // ====== بخش مهم: مدیریت پاپ‌آپ احراز هویت ======
    var authButton = document.getElementById('user-auth-button');
    var authPopup = document.getElementById('auth-popup');
    
    // اگر پاپ‌آپ در DOM وجود داشت، مدیریت کن
    if (authButton && authPopup) {
      authButton.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        console.log('دکمه کاربر کلیک شد - باز کردن پاپ‌آپ');
        authPopup.classList.remove('hidden');
        // تابع switchTab باید قبلاً تعریف شده باشد
        if (typeof switchTab === 'function') {
          switchTab('login');
        }
      });
      
      // بستن پاپ‌آپ با کلیک روی پس‌زمینه
      authPopup.addEventListener('click', function(e) {
        if (e.target === authPopup) {
          authPopup.classList.add('hidden');
        }
      });
    } else {
      console.warn('دکمه user-auth-button یا پاپ‌آپ auth-popup در صفحه پیدا نشد!');
      
      // اگر پاپ‌آپ وجود نداشت، می‌توانیم یک هشدار نمایش دهیم یا لاگ بگیریم
      if (!authButton) console.warn('عنصر با آیدی user-auth-button یافت نشد');
      if (!authPopup) console.warn('عنصر با آیدی auth-popup یافت نشد');
    }
  });
</script>

  <!-- Hero Slider -->
<style>
  /* استایل‌های اسلایدر */
  .hero-slider {
    position: relative;
    width: 100%;
    overflow: hidden;
    margin-top: 70px;
  }
  
  .slide {
    position: relative;
    width: 100%;
    height: 85vh;
    min-height: 500px;
    display: none;
    opacity: 0;
    transition: opacity 0.5s ease-in-out;
  }
  
  .slide.active {
    display: block;
    opacity: 1;
  }
  
  .slide-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    transition: transform 0.3s ease;
  }
  
  /* لایه تیره */
  .slide-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0.2) 100%);
  }
   .hero-slider {
    border-radius: 10px;
    overflow: hidden;
  }
  
  .slide,
  .slide-bg {
    border-radius: 10px;
  }
  /* محتوای اسلاید */
  .slide-content {
    position: relative;
    z-index: 10;
    height: 100%;
    display: flex;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }
  
  /* دکمه‌های navigation */
  .slider-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 45px;
    height: 45px;
    background: rgba(255,255,255,0.2);
    backdrop-filter: blur(5px);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    z-index: 20;
    color: white;
    font-size: 20px;
    border: 1px solid rgba(255,255,255,0.3);
  }
  
  .slider-nav:hover {
    background: rgba(255,255,255,0.4);
    transform: translateY(-50%) scale(1.1);
  }
  
  .slider-prev {
    left: 20px;
  }
  
  .slider-next {
    right: 20px;
  }
  
  /* دات‌های پایین */
  .slider-dots {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
