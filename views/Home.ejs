<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>فروشگاه کیدل</title>
    <meta
    name="description"
    content="فروشگاه اینترنتی کیدل، فروش لباس بچگانه از سنین 1 تا 15 سال"
  />
  <meta name="keywords" content="محصولات شیگلم, خرید فروش محصولات شیگلم , خرید محصولات شیگلم , محصولات آرایشی" />
  <!-- <link href="https://unpkg.com/tailwindcss@^2/dist/tailwind.min.css" rel="stylesheet"> -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="/tailwind.min.css">
  <style>

    /* ==== RESET & FONTS ==== */


    /* ==== MAIN SHELL ==== */
    .page-shell {
          border-radius: 25px;
      width: 100%;
      padding: clamp(8px, 2vw, 20px);
      background: radial-gradient(circle at 20% 20%, rgba(255, 209, 220, 0.4), #fff5f7);
    }


    /* ==== CENTERED HERO FRAME ==== */
    .hero-frame {
      min-height: 100%;
      width: 100%;
      display: flex;
      align-items: center;
      padding: clamp(18px, 4vw, 15px);
      position: relative;
    }

    .hero-frame::before {
      content: "";
      position: absolute;
      inset: 4%;
      border-radius: 42px;
      background-image:
        linear-gradient(90deg, rgba(255,255,255,0.35) 1px, transparent 1px),
        linear-gradient(rgba(255,255,255,0.35) 1px, transparent 1px);
      background-size: 38px 38px;
      mask-image: radial-gradient(circle at center, black 0%, transparent 68%);
      pointer-events: none;
    }

    /* ==== MAIN CARD (SINGLE SLIDE) ==== */
    .hero-card {
      width: min(1220px, 100%);
      margin: 0 auto;
      position: relative;
      background: rgba(255, 255, 255, 0.72);
      border: 1px solid rgba(255, 255, 255, 0.86);
      box-shadow: 0 28px 80px rgba(173, 83, 108, 0.18);
      border-radius: clamp(26px, 4vw, 48px);
      overflow: hidden;
      backdrop-filter: blur(18px);
      transition: background-color 0.2s ease;
    }

    /* ==== TOPBAR (brand + optional badge) ==== */
    .hero-topbar {
      position: absolute;
      top: clamp(16px, 3vw, 30px);
      right: clamp(16px, 3vw, 34px);
      left: clamp(16px, 3vw, 34px);
      z-index: 8;
      display: flex;
      justify-content: space-between;
      align-items: center;
      pointer-events: none;
    }

    .brand-pill {
      pointer-events: auto;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 10px 16px;
      border-radius: 999px;
      background: #ffffff;
      box-shadow: 0 12px 30px rgba(144, 61, 84, 0.13);
      color: #51313c;
      font-weight: 900;
      letter-spacing: -0.03em;
      transition: background 0.2s, color 0.2s;
    }

    .brand-mark {
      width: 34px;
      height: 34px;
      border-radius: 14px;
      background: #FFD1DC;
      display: grid;
      place-items: center;
      box-shadow: inset 0 -5px 8px rgba(255, 255, 255, 0.7);
      transition: background 0.2s;
    }

    .brand-mark svg {
      width: 23px;
      height: 23px;
    }

    .deco-badge {
      pointer-events: auto;
      padding: 9px 14px;
      border-radius: 999px;
      background: rgba(81, 49, 60, 0.08);
      color: #51313c;
      font-weight: 800;
      font-size: 14px;
      transition: background 0.2s, color 0.2s;
    }

    /* ==== SINGLE SLIDE LAYOUT ==== */
.single-slide {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16px;
  padding: clamp(20px, 5vw, 36px) clamp(16px, 4vw, 40px);
}
@media (min-width: 768px) {
  .single-slide {
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    padding: 32px 48px;
  }
}

h1 {
  font-size: clamp(20px, 5.5vw, 32px);
  margin-bottom: 10px;
}

.lead {
  font-size: clamp(12px, 3.2vw, 15px);
  margin-bottom: 18px;
}

.hero-button {
  padding: 8px 18px;
  font-size: clamp(11px, 3.2vw, 14px);
}
.art-zone {
  min-height: 200px;
}

.closet-orbit {
  width: min(220px, 60%);
}

@media (min-width: 768px) {
  .closet-orbit {
    width: min(300px, 80%);
  }
}
    .single-slide::after {
      content: "";
      position: absolute;
      width: 34%;
      aspect-ratio: 1;
      border-radius: 50%;
      background: rgba(255, 209, 220, 0.48);
      filter: blur(20px);
      left: 6%;
      bottom: 6%;
      z-index: 0;
      pointer-events: none;
    }

    .copy-zone,
    .art-zone {
      position: relative;
      z-index: 1;
    }

    .mini-label {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 13px;
      border-radius: 999px;
      background: rgba(255, 209, 220, 0.72);
      color: #51313c;
      font-weight: 800;
      margin-bottom: clamp(14px, 2vw, 22px);
      box-shadow: 0 9px 22px rgba(173, 83, 108, 0.12);
      transition: background 0.2s, color 0.2s;
    }

    .mini-label span {
      width: 8px;
      height: 8px;
      border-radius: 999px;
      background: #e87899;
      box-shadow: 0 0 0 5px rgba(232, 120, 153, 0.15);
      transition: background 0.2s;
    }


    .lead {
      margin: clamp(14px, 2vw, 22px) 0 0;
      color: rgba(81, 49, 60, 0.78);
      font-size: clamp(15px, 1.65vw, 22px);
      line-height: 1.9;
      max-width: 560px;
      font-weight: 500;
      transition: color 0.2s;
    }

    .cta-row {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: clamp(20px, 3vw, 34px);
    }

    .hero-button {
      min-height: 48px;
      border: 0;
      border-radius: 999px;
      padding: 13px 22px;
      font: inherit;
      font-weight: 900;
      cursor: pointer;
      transition: transform 220ms ease, box-shadow 220ms ease, background 220ms ease;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
    }

    .hero-button:focus-visible {
      outline: 3px solid rgba(81, 49, 60, 0.45);
      outline-offset: 3px;
    }

    .primary-btn {
      background: #51313c;
      color: #ffffff;
      box-shadow: 0 16px 30px rgba(81, 49, 60, 0.2);
      transition: background 0.2s, color 0.2s;
    }

    .secondary-btn {
      background: #ffffff;
      color: #51313c;
      box-shadow: 0 12px 26px rgba(173, 83, 108, 0.12);
      transition: background 0.2s, color 0.2s;
    }

    .hero-button:hover {
      transform: translateY(-3px);
    }

    /* ==== ART / GRAPHIC ZONE (animated like before) ==== */
    .art-zone {
      min-height: clamp(280px, 42vw, 520px);
      display: grid;
      place-items: center;
    }

    .closet-orbit {
      width: min(470px, 100%);
      aspect-ratio: 1;
      position: relative;
      display: grid;
      place-items: center;
      border-radius: 42% 58% 45% 55% / 56% 44% 56% 44%;
      background: radial-gradient(circle at 34% 24%, #ffffff 0 12%, transparent 13%),
                  linear-gradient(145deg, rgba(255, 209, 220, 0.93), rgba(255, 255, 255, 0.92));
      box-shadow: inset 0 0 0 12px rgba(255,255,255,0.42), 0 30px 62px rgba(173, 83, 108, 0.18);
      animation: blobFloat 6s ease-in-out infinite;
    }

    @keyframes blobFloat {
      0%, 100% { border-radius: 42% 58% 45% 55% / 56% 44% 56% 44%; transform: translateY(0); }
      50% { border-radius: 56% 44% 58% 42% / 42% 58% 44% 56%; transform: translateY(-2.5%); }
    }

    .hanger-line {
      position: absolute;
      top: 19%;
      width: 64%;
      height: 12px;
      border-radius: 99px;
      background: #ffffff;
      box-shadow: 0 9px 18px rgba(173, 83, 108, 0.12);
    }

    .main-garment {
      width: 58%;
      filter: drop-shadow(0 20px 24px rgba(144, 61, 84, 0.16));
      animation: garmentSway 4.8s ease-in-out infinite;
      transform-origin: 50% 0%;
    }

    @keyframes garmentSway {
      0%, 100% { transform: rotate(-2deg); }
      50% { transform: rotate(2.5deg); }
    }

    .floating-icon {
      position: absolute;
      display: grid;
      place-items: center;
      width: clamp(54px, 7vw, 82px);
      height: clamp(54px, 7vw, 82px);
      border-radius: 26px;
      background: #ffffff;
      box-shadow: 0 16px 38px rgba(173, 83, 108, 0.17);
      animation: softBob 4.4s ease-in-out infinite;
    }

    .floating-icon svg {
      width: 62%;
      height: 62%;
    }

    .icon-one { top: 11%; right: -3%; animation-delay: -0.4s; }
    .icon-two { bottom: 12%; right: 4%; animation-delay: -1.5s; }
    .icon-three { bottom: 8%; left: -2%; animation-delay: -2.3s; }

    @keyframes softBob {
      0%, 100% { transform: translateY(0) rotate(-3deg); }
      50% { transform: translateY(-10%) rotate(3deg); }
    }

    /* ==== SPARK DECOR ==== */
    .spark {
      position: absolute;
      border-radius: 999px;
      background: rgba(255,255,255,0.92);
      box-shadow: 0 8px 20px rgba(173, 83, 108, 0.08);
      pointer-events: none;
    }
    .spark-a { width: 14px; height: 14px; top: 26%; left: 8%; }
    .spark-b { width: 22px; height: 22px; top: 18%; left: 31%; }
    .spark-c { width: 11px; height: 11px; bottom: 22%; right: 47%; }

    /* ==== RESPONSIVE (same as before but single column on mobile) ==== */
    @media (max-width: 900px) {
      .hero-frame { padding: 18px; }
      .single-slide {
        grid-template-columns: 1fr;
        text-align: center;
        padding: 92px 22px 92px;
        gap: 16px;
      }
      h1, .lead { margin-left: auto; margin-right: auto; }
      .cta-row { justify-content: center; }
      .art-zone { min-height: 330px; order: -1; }
      .closet-orbit { width: min(360px, 82%); }
    }

    @media (max-width: 520px) {
      .hero-frame { padding: 10px; }
      .hero-card { border-radius: 28px; }
      .hero-topbar { top: 12px; right: 12px; left: 12px; }
      .brand-pill { padding: 8px 11px; gap: 7px; font-size: 13px; }
      .brand-mark { width: 28px; height: 28px; border-radius: 11px; }
      .deco-badge { padding: 7px 10px; font-size: 12px; }
      .single-slide { padding: 25px 14px 10px; }
      .art-zone { min-height: 238px; }
      .closet-orbit { width: min(255px, 82%); }
      .floating-icon { width: 48px; height: 48px; border-radius: 17px; }
      h1 { font-size: clamp(25px, 8vw, 34px); }
      .lead { font-size: clamp(13px, 4vw, 15px); line-height: 1.75; }
      .mini-label { font-size: 12px; padding: 7px 10px; margin-bottom: 10px; }
      .hero-button { min-height: 44px; padding: 11px 15px; font-size: 13px; flex: 1 1 130px; }
      .cta-row { gap: 8px; }
    }

    @media (prefers-reduced-motion: reduce) {
      .hero-button, .closet-orbit, .main-garment, .floating-icon {
        animation: none;
        transition: none;
      }
    }

    @font-face {
      font-family: "MyFont";
      src: url("/fonts/Vazirmatn-Light.ttf");
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }

    body {
      font-family: "MyFont", sans-serif;
      scroll-behavior: smooth;
