                          <path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"></path>
                          <circle cx="9" cy="20" r="1"></circle>
                          <circle cx="20" cy="20" r="1"></circle>
                        </svg>

                        <!-- آیکون تیک (مخفی شده) -->
