<script>
  // اسلایدر دسته‌بندی‌ها
const slider = document.getElementById('categoriesSlider');
const track = document.getElementById('categoriesTrack');
const scrollLeftBtn = document.getElementById('scrollCategoriesLeft');
const scrollRightBtn = document.getElementById('scrollCategoriesRight');

if (scrollLeftBtn && scrollRightBtn && slider) {
    // اسکرول به چپ (رفتن به آیتم‌های قبلی)
    scrollLeftBtn.addEventListener('click', () => {
        const cardWidth = document.querySelector('.category-card')?.offsetWidth || 200;
        const gap = 24; // مقدار gap بین کارت‌ها
        const scrollAmount = cardWidth + gap;
        slider.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
    });

    // اسکرول به راست (رفتن به آیتم‌های بعدی)
    scrollRightBtn.addEventListener('click', () => {
        const cardWidth = document.querySelector('.category-card')?.offsetWidth || 200;
        const gap = 24;
        const scrollAmount = cardWidth + gap;
        slider.scrollBy({ left: scrollAmount, behavior: 'smooth' });
    });

    // مخفی کردن دکمه‌ها در ابتدا و انتهای اسکرول
    function checkScrollButtons() {
        const scrollLeft = slider.scrollLeft;
        const maxScroll = slider.scrollWidth - slider.clientWidth;
        
        if (scrollLeft <= 10) {
            scrollLeftBtn.style.opacity = '0.3';
            scrollLeftBtn.style.pointerEvents = 'none';
        } else {
            scrollLeftBtn.style.opacity = '1';
            scrollLeftBtn.style.pointerEvents = 'auto';
        }
        
        if (scrollLeft >= maxScroll - 10) {
            scrollRightBtn.style.opacity = '0.3';
            scrollRightBtn.style.pointerEvents = 'none';
        } else {
            scrollRightBtn.style.opacity = '1';
            scrollRightBtn.style.pointerEvents = 'auto';
        }
    }

    slider.addEventListener('scroll', checkScrollButtons);
    window.addEventListener('resize', checkScrollButtons);
    setTimeout(checkScrollButtons, 100);
}
</script>
