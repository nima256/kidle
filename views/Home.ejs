              <button onclick="location.href='/productDetails/<%= product.slug %>';" class="view-btn w-full bg-gradient-to-r from-pink-500 to-purple-600 text-white py-2 sm:py-2.5 rounded-xl text-sm sm:text-base font-medium flex items-center justify-center gap-1 sm:gap-2 transition-all hover:opacity-90">
