  <script>
    // توابع کمکی
    function toPersianDigits(num) {
      if (num === undefined || num === null) return '۰';
      return num.toString().replace(/\d/g, d => '۰۱۲۳۴۵۶۷۸۹'[d]);
    }

    function showNotification(message, type = 'info') {
      const notification = document.createElement('div');
      notification.className = `fixed z-50 px-4 py-3 rounded-lg shadow-lg text-white text-sm sm:text-base ${
        type === 'success' ? 'bg-green-500' :
        type === 'error' ? 'bg-red-500' :
        'bg-blue-500'
      } top-4 left-1/2 -translate-x-1/2 sm:left-auto sm:translate-x-0 sm:top-6 sm:right-6 w-[calc(100%-2rem)] max-w-xs sm:max-w-sm`;
      notification.textContent = message;
      document.body.appendChild(notification);
      notification.classList.add('transform', 'transition-all', 'duration-300', 'translate-y-2', 'opacity-0');
      setTimeout(() => notification.classList.remove('translate-y-2', 'opacity-0'), 10);
      setTimeout(() => {
        notification.classList.add('opacity-0', 'translate-y-2');
        setTimeout(() => notification.remove(), 300);
      }, 800);
    }

    document.addEventListener("DOMContentLoaded", function() {
      // منوی همبرگری موبایل
      var menuBtn = document.getElementById('menu-btn');
      var mobileMenu = document.getElementById('mobile-menu');
      
      if (menuBtn && mobileMenu) {
        menuBtn.onclick = function(e) {
          e.stopPropagation();
          if (mobileMenu.style.display === 'none' || mobileMenu.style.display === '') {
            mobileMenu.style.display = 'flex';
          } else {
            mobileMenu.style.display = 'none';
          }
        };
      }
      
      // ساب‌منوی موبایل
      var mobileTriggers = document.querySelectorAll('.mobile-dropdown-trigger');
      mobileTriggers.forEach(function(trigger) {
        trigger.onclick = function(e) {
          e.stopPropagation();
          var menu = this.nextElementSibling;
          var icon = this.querySelector('i');
          if (menu.style.display === 'none' || menu.style.display === '') {
            menu.style.display = 'block';
            icon.style.transform = 'rotate(180deg)';
          } else {
            menu.style.display = 'none';
            icon.style.transform = 'rotate(0deg)';
          }
        };
      });
      
      var subTriggers = document.querySelectorAll('.mobile-submenu-trigger');
      subTriggers.forEach(function(trigger) {
        trigger.onclick = function(e) {
          e.stopPropagation();
          var submenu = this.nextElementSibling;
          var icon = this.querySelector('i');
          if (submenu.style.display === 'none' || submenu.style.display === '') {
            submenu.style.display = 'block';
            icon.style.transform = 'rotate(180deg)';
          } else {
            submenu.style.display = 'none';
            icon.style.transform = 'rotate(0deg)';
          }
        };
      });

      // ====== مدیریت پاپ‌آپ احراز هویت ======
      var authButton = document.getElementById('user-auth-button');
      var authPopup = document.getElementById('auth-popup');
      
      function switchTab(activeTab) {
        const tabs = { login: document.getElementById('login-tab'), register: document.getElementById('register-tab'), forgot: document.getElementById('forgot-tab') };
        const contents = { login: document.getElementById('login-content'), register: document.getElementById('register-content'), forgot: document.getElementById('forgot-content') };
        
        Object.values(tabs).forEach(tab => {
          if(tab) {
            tab.classList.remove('border-pink-500', 'text-pink-500');
            tab.classList.add('text-gray-500');
          }
        });
        Object.values(contents).forEach(content => {
          if(content) content.classList.remove('active');
        });
        if(tabs[activeTab]) {
          tabs[activeTab].classList.add('border-pink-500', 'text-pink-500');
          tabs[activeTab].classList.remove('text-gray-500');
        }
        if(contents[activeTab]) contents[activeTab].classList.add('active');
      }
      
      if (authButton && authPopup) {
        authButton.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          authPopup.classList.remove('hidden');
          switchTab('login');
        });
        
        authPopup.addEventListener('click', function(e) {
          if (e.target === authPopup) {
            authPopup.classList.add('hidden');
          }
        });
      }

      // OTP inputs setup
      function setupOtpInputs(containerSelector) {
        const inputs = Array.from(document.querySelectorAll(`${containerSelector} .otp-input`));
        if (inputs.length === 0) return;
        inputs.forEach((input, index) => {
          input.addEventListener('input', function() {
            if (this.value.length === 1 && index > 0) {
              inputs[index - 1].focus();
            }
          });
          input.addEventListener('keydown', function(e) {
            if (e.key === 'Backspace' && this.value.length === 0 && index < inputs.length - 1) {
              inputs[index + 1].focus();
            }
          });
        });
      }
      
      setupOtpInputs('#register-step-2');
      setupOtpInputs('#forgot-step-2');
      
      // Register form
      const registerForm = document.getElementById('register-form');
      const registerStep1 = document.getElementById('register-step-1');
      const registerStep2 = document.getElementById('register-step-2');
      const registerPhoneDisplay = document.getElementById('register-phone-display');
      
      if (registerForm) {
        registerForm.addEventListener('submit', function(e) {
          e.preventDefault();
          const phone = document.getElementById('register-phone').value;
          if(registerPhoneDisplay) registerPhoneDisplay.textContent = phone;
          if(registerStep1) registerStep1.classList.remove('active');
          if(registerStep2) registerStep2.classList.add('active');
          
          fetch('/api/mobile/sendOtp', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ mobile: phone })
          }).catch(err => console.log('OTP send error:', err));
        });
      }
      
      const registerBackBtn = document.getElementById('register-back-btn');
      if (registerBackBtn) {
        registerBackBtn.addEventListener('click', function() {
          if(registerStep2) registerStep2.classList.remove('active');
          if(registerStep1) registerStep1.classList.add('active');
        });
      }
      
      // Login form
      const loginForm = document.getElementById('login-form');
      if (loginForm) {
        loginForm.addEventListener('submit', function(e) {
          e.preventDefault();
          const formData = new FormData(loginForm);
          fetch('/api/authentication/signIn', {
            method: 'POST',
            body: formData
          })
          .then(res => res.json())
          .then(data => {
            if (data.success) {
              showNotification(data.message, 'success');
              setTimeout(() => location.reload(), 800);
              if(authPopup) authPopup.classList.add('hidden');
            } else {
              showNotification(data.message, 'error');
            }
          }).catch(err => showNotification('خطا در ارتباط با سرور', 'error'));
        });
      }
    });
  </script>

  <script>
    // اسکریپت‌های اصلی صفحه (تب‌ها و تنظیمات SDK)
    const defaultConfig = {
      background_color: "#fff7fa",
      surface_color: "#ffffff",
      text_color: "#4c2335",
      primary_action_color: "#d94f86",
      secondary_action_color: "#7a4058",
      font_family: "Vazirmatn",
      font_size: 16,
      site_title: "مرکز اطلاعات و پشتیبانی",
      site_subtitle: "همه چیز درباره تماس، ارتباط، قوانین و حریم خصوصی در یک فضای ساده و آرام.",
      contact_title: "تماس با ما",
      contact_body: "برای دریافت راهنمایی، ثبت درخواست یا پرسیدن سوال، از طریق ایمیل، شماره تماس یا فرم‌های ارتباطی برند با ما در تماس باشید. ما تلاش می‌کنیم پاسخ‌ها دقیق، محترمانه و سریع باشند.",
      connect_title: "ارتباط با ما",
      connect_body: "ما به گفت‌وگوهای واقعی و سازنده اهمیت می‌دهیم. پیشنهادها، همکاری‌ها، بازخوردها و ایده‌های خود را با ما به اشتراک بگذارید تا تجربه بهتری برای شما بسازیم.",
      terms_title: "قوانین و مقررات",
      terms_body: "استفاده از خدمات به معنای پذیرش قوانین، احترام به حقوق کاربران و رعایت چارچوب‌های اخلاقی و قانونی است. لطفاً پیش از استفاده، شرایط را با دقت مطالعه کنید.",
      privacy_title: "سیاست حریم خصوصی",
      privacy_body: "حفظ حریم خصوصی کاربران برای ما مهم است. اطلاعاتی که با ما به اشتراک می‌گذارید فقط برای ارائه خدمات بهتر، پاسخ‌گویی و بهبود تجربه شما استفاده می‌شود.",
      footer_text: "ساخته شده با ظاهری لطیف، ساده و قابل اعتماد."
    };

    function getConfigValue(config, key) {
      return config[key] || defaultConfig[key];
    }

    function applyText(id, value) {
      const element = document.getElementById(id);
      if (element) element.textContent = value;
    }

    async function onConfigChange(config) {
      const backgroundColor = getConfigValue(config, "background_color");
      const surfaceColor = getConfigValue(config, "surface_color");
      const textColor = getConfigValue(config, "text_color");
      const primaryActionColor = getConfigValue(config, "primary_action_color");
      const secondaryActionColor = getConfigValue(config, "secondary_action_color");
      const fontFamily = getConfigValue(config, "font_family");
      const fontSize = Number(config.font_size || defaultConfig.font_size);

      const app = document.getElementById("app");
      app.style.color = textColor;
      app.style.background = `radial-gradient(circle at 12% 18%, ${primaryActionColor}22 0, transparent 28%), radial-gradient(circle at 82% 14%, #ffd6e5 0, transparent 30%), linear-gradient(135deg, ${backgroundColor} 0%, #ffeef5 48%, ${surfaceColor} 100%)`;
      app.style.fontFamily = `${fontFamily}, Vazirmatn, Tahoma, sans-serif`;

      document.querySelectorAll(".glass-card").forEach((card) => {
        card.style.backgroundColor = `${surfaceColor}ad`;
        card.style.borderColor = `${primaryActionColor}4d`;
      });

      document.querySelectorAll(".nav-button").forEach((button) => {
        if (button.classList.contains("active")) {
          button.style.backgroundColor = primaryActionColor;
          button.style.color = surfaceColor;
        } else {
          button.style.backgroundColor = "transparent";
          button.style.color = secondaryActionColor;
        }
      });

      applyText("siteTitle", getConfigValue(config, "site_title"));
      applyText("siteSubtitle", getConfigValue(config, "site_subtitle"));
      applyText("contactTitle", getConfigValue(config, "contact_title"));
      applyText("contactBody", getConfigValue(config, "contact_body"));
      applyText("connectTitle", getConfigValue(config, "connect_title"));
      applyText("connectBody", getConfigValue(config, "connect_body"));
      applyText("termsTitle", getConfigValue(config, "terms_title"));
      applyText("termsBody", getConfigValue(config, "terms_body"));
      applyText("privacyTitle", getConfigValue(config, "privacy_title"));
      applyText("privacyBody", getConfigValue(config, "privacy_body"));
      applyText("footerText", getConfigValue(config, "footer_text"));
    }

    function setActivePage(pageName) {
      document.querySelectorAll(".page-panel").forEach((panel) => {
        panel.classList.remove("active");
      });

      const targetPanel = document.getElementById(`page-${pageName}`);
      if (targetPanel) targetPanel.classList.add("active");

      document.querySelectorAll(".nav-button").forEach((button) => {
        const isActive = button.dataset.page === pageName;
        button.classList.toggle("active", isActive);
        button.setAttribute("aria-selected", isActive ? "true" : "false");
      });

      const config = window.elementSdk ? window.elementSdk.config : defaultConfig;
      onConfigChange(config);
    }

    document.querySelectorAll(".nav-button").forEach((button) => {
      button.addEventListener("click", () => {
        setActivePage(button.dataset.page);
      });
    });

    if (window.elementSdk) {
      window.elementSdk.init({
        defaultConfig,
        onConfigChange,
        mapToCapabilities: (config) => ({
          recolorables: [
            { get: () => config.background_color || defaultConfig.background_color, set: (value) => { config.background_color = value; window.elementSdk.setConfig({ background_color: value }); } },
            { get: () => config.surface_color || defaultConfig.surface_color, set: (value) => { config.surface_color = value; window.elementSdk.setConfig({ surface_color: value }); } },
            { get: () => config.text_color || defaultConfig.text_color, set: (value) => { config.text_color = value; window.elementSdk.setConfig({ text_color: value }); } },
            { get: () => config.primary_action_color || defaultConfig.primary_action_color, set: (value) => { config.primary_action_color = value; window.elementSdk.setConfig({ primary_action_color: value }); } },
            { get: () => config.secondary_action_color || defaultConfig.secondary_action_color, set: (value) => { config.secondary_action_color = value; window.elementSdk.setConfig({ secondary_action_color: value }); } }
          ],
          borderables: [],
          fontEditable: { get: () => config.font_family || defaultConfig.font_family, set: (value) => { config.font_family = value; window.elementSdk.setConfig({ font_family: value }); } },
          fontSizeable: { get: () => config.font_size || defaultConfig.font_size, set: (value) => { config.font_size = value; window.elementSdk.setConfig({ font_size: value }); } }
        }),
        mapToEditPanelValues: (config) => new Map([
          ["site_title", config.site_title || defaultConfig.site_title],
          ["site_subtitle", config.site_subtitle || defaultConfig.site_subtitle],
          ["contact_title", config.contact_title || defaultConfig.contact_title],
          ["contact_body", config.contact_body || defaultConfig.contact_body],
          ["connect_title", config.connect_title || defaultConfig.connect_title],
          ["connect_body", config.connect_body || defaultConfig.connect_body],
          ["terms_title", config.terms_title || defaultConfig.terms_title],
          ["terms_body", config.terms_body || defaultConfig.terms_body],
          ["privacy_title", config.privacy_title || defaultConfig.privacy_title],
          ["privacy_body", config.privacy_body || defaultConfig.privacy_body],
          ["footer_text", config.footer_text || defaultConfig.footer_text]
        ])
      });
    } else {
      onConfigChange(defaultConfig);
    }

    if (window.lucide) {
      lucide.createIcons();
    }
  </script>

 </body>
</html>