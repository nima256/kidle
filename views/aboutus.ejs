  <style>
    @font-face {
      font-family: "MyFont";
      src: url("/fonts/Vazirmatn-Light.ttf");
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }

    html, body {
      height: 100%;
      width: 100%;
      margin: 0;
      font-family: "MyFont", sans-serif;
    }

    body {
      font-family: "MyFont", sans-serif;
    }

    * {
      box-sizing: border-box;
      font-family: "MyFont", sans-serif;
    }

    /* استایل‌های نوبار */
    .cart-count {
      top: -8px;
      left: -8px;
    }

    .nav-link {
      transition: all 0.3s ease;
      position: relative;
    }

    .nav-link:hover::after {
      width: 100%;
      right: 0;
    }

    .dropdown:hover .dropdown-menu {
      display: block !important;
    }
    
    .submenu-item:hover .submenu-level2 {
      display: block !important;
    }
    
    .dropdown-menu a:hover,
    .submenu-level2 a:hover {
      background-color: #f5f5f5;
    }

    @media (min-width: 768px) {
      .desktop-menu {
        display: flex !important;
      }
      .hamburger {
        display: none !important;
      }
    }

    body.menu-open {
      overflow: hidden;
      position: fixed;
      width: 100%;
      height: 100%;
    }

    /* استایل‌های اصلی صفحه */
    .soft-grid {
      background-image:
        radial-gradient(circle at 12% 18%, rgba(255, 117, 162, 0.22) 0, transparent 28%),
        radial-gradient(circle at 82% 14%, rgba(255, 214, 229, 0.92) 0, transparent 30%),
        radial-gradient(circle at 54% 88%, rgba(255, 143, 184, 0.22) 0, transparent 34%),
        linear-gradient(135deg, #fff7fa 0%, #ffeef5 48%, #fffafc 100%);
    }

    .orb {
      position: absolute;
      border-radius: 999px;
      filter: blur(1px);
      opacity: 0.85;
      animation: floaty 8s ease-in-out infinite;
      pointer-events: none;
    }

    .orb-one {
      width: 118px;
      height: 118px;
      background: rgba(255, 143, 184, 0.24);
      top: 8%;
      right: 8%;
      animation-delay: 0s;
    }

    .orb-two {
      width: 78px;
      height: 78px;
      background: rgba(255, 196, 217, 0.48);
      bottom: 12%;
      left: 12%;
      animation-delay: 1.3s;
    }

    .orb-three {
      width: 42px;
      height: 42px;
      background: rgba(211, 77, 123, 0.16);
      top: 58%;
      right: 18%;
      animation-delay: 2.1s;
    }

    @keyframes floaty {
      0%, 100% { transform: translateY(0%) scale(1); }
      50% { transform: translateY(-16%) scale(1.04); }
    }

    .glass-card {
      background: rgba(255, 255, 255, 0.68);
      border: 1px solid rgba(255, 174, 203, 0.42);
      box-shadow: 0 28px 80px rgba(193, 74, 118, 0.16);
      backdrop-filter: blur(22px);
    }

    .nav-button {
      transition: transform 180ms ease, background 180ms ease, color 180ms ease, box-shadow 180ms ease;
    }

    .nav-button:hover {
      transform: translateY(-2px);
    }

    .nav-button.active {
      background: #d94f86;
      color: #ffffff;
      box-shadow: 0 14px 32px rgba(217, 79, 134, 0.28);
    }

    .page-panel {
      display: none;
      animation: riseIn 420ms ease both;
    }

    .page-panel.active {
      display: block;
    }

    @keyframes riseIn {
      from {
        opacity: 0;
        transform: translateY(4%);
      }
      to {
        opacity: 1;
        transform: translateY(0%);
      }
    }

    .mini-line {
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(217, 79, 134, 0.42), transparent);
    }

    .focus-ring:focus-visible {
      outline: 3px solid rgba(217, 79, 134, 0.45);
      outline-offset: 3px;
    }

    /* استایل‌های پاپ‌آپ احراز هویت */
    .tab-content {
      display: none;
    }
    .tab-content.active {
      display: block;
    }
    .form-step {
      display: none;
    }
    .form-step.active {
      display: block;
    }
    .otp-input {
      width: 3rem;
      height: 3.5rem;
      font-size: 1.5rem;
      text-align: center;
      border: 1px solid #d1d5db;
      border-radius: 0.5rem;
    }
    .modal-content {
      animation: modalFadeIn 0.3s ease-out;
    }
    @keyframes modalFadeIn {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* استایل ریسپانسیو برای نوبار موبایل */
    @media (max-width: 768px) {
      .flex.items-center.space-x-4 {
        gap: 12px;
      }
    }

.cart-count {
    top: -8px;
    left: -8px;
}
  </style>
