<%- include('../partials/layout-top') %>
<div class="wrap max-w-md py-12">
  <div class="state panel">
    <p class="badge badge-danger">فقط محیط توسعه — درگاه آزمایشی</p>
    <h1 class="state-title">پرداخت <%= price(amount) %> تومان</h1>
    <p class="ltr text-xs text-ink-500">Authority: <%= authority %></p>
    <div class="mt-2 flex w-full flex-col gap-2">
      <a class="btn btn-primary btn-lg" id="pay-ok" href="/api/order/verify?Authority=<%= authority %>&Status=OK">پرداخت موفق</a>
      <a class="btn btn-outline" id="pay-nok" href="/api/order/verify?Authority=<%= authority %>&Status=NOK">انصراف از پرداخت</a>
    </div>
  </div>
</div>
<%- include('../partials/layout-bottom') %>
