<%
  var abs = function (u) { return u && u.startsWith('http') ? u : siteUrl + u; };
  locals.jsonld = { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: post.title, description: post.description,
    image: post.images && post.images[0] ? abs(post.images[0].url) : undefined,
    datePublished: (post.publishedAt || post.createdAt), dateModified: post.updatedAt,
    author: { '@type': 'Organization', name: 'کیدل' }, publisher: { '@type': 'Organization', name: 'کیدل', logo: { '@type': 'ImageObject', url: siteUrl + '/favicon.svg' } },
    mainEntityOfPage: canonical };
%>
<%- include('../partials/layout-top') %>
<article class="pb-4">
  <div class="wrap max-w-3xl">
    <%- include('../partials/breadcrumbs', { crumbs: [{ name: 'مجله کیدل', url: '/weblog' }, { name: post.title }], crumbClass: 'pt-3 pb-2 lg:pt-5' }) %>
    <header class="pt-2 pb-6 text-center lg:pt-6">
      <% if (post.categories && post.categories.length) { %><p class="eyebrow no-rule justify-center"><%= post.categories.map(function (c) { return c.name; }).join('، ') %></p><% } %>
      <h1 class="t-display mt-3 !text-[clamp(1.875rem,1.4rem+2vw,2.875rem)]"><%= post.title %></h1>
      <p class="mt-4 flex flex-wrap items-center justify-center gap-3 text-sm text-ink-500">
        <span><%= faDate(post.publishedAt || post.createdAt) %></span><span aria-hidden="true">·</span>
        <span class="flex items-center gap-1"><%- icon('clock','icon-sm') %><%= fa(post.readingTime || 5) %> دقیقه مطالعه</span>
      </p>
    </header>
  </div>
  <% if (post.images && post.images[0]) { %>
  <figure class="wrap max-w-5xl"><div class="overflow-hidden rounded-xl bg-linen-100"><img src="<%= post.images[0].url %>" alt="<%= post.images[0].alt || post.title %>" class="max-h-[34rem] w-full object-cover" fetchpriority="high"></div><% if (post.images[0].caption) { %><figcaption class="p-2 text-center text-xs text-ink-500"><%= post.images[0].caption %></figcaption><% } %></figure>
  <% } %>
  <div class="wrap max-w-2xl">
    <% if (post.description) { %><p class="mt-8 font-display text-xl leading-9 text-ink-950"><%= post.description %></p><% } %>
    <div class="prose-kid mt-6"><%- post.content %></div>

    <aside class="mt-10 flex flex-col items-center gap-4 rounded-xl bg-brand-50 p-6 text-center sm:flex-row sm:text-start">
      <span class="arch flex h-16 w-14 shrink-0 items-center justify-center bg-brand-600 text-white"><%- icon('bag') %></span>
      <p class="flex-1"><b class="block font-display text-lg text-ink-950">وقت خرید است؟</b><span class="text-sm text-ink-700">لباس‌های نرم و باکیفیت برای فرزندتان را در کیدل ببینید.</span></p>
      <a class="btn btn-primary shrink-0" href="/shop">رفتن به فروشگاه</a>
    </aside>
  </div>

  <% if (related.length) { %>
  <section class="wrap section" aria-labelledby="rp-title">
    <div class="sec-head"><div><p class="eyebrow">ادامه مطالعه</p><h2 id="rp-title" class="t-section mt-1">مقاله‌های مرتبط</h2></div></div>
    <div class="grid gap-x-6 gap-y-10 sm:grid-cols-3"><% related.forEach(function (w) { %><%- include('../partials/post-card', { w: w, cls: '' }) %><% }) %></div>
  </section>
  <% } %>
</article>
<%- include('../partials/layout-bottom') %>
