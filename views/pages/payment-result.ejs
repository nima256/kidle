<%- include('../partials/layout-top') %>
<div class="wrap max-w-xl py-8 sm:py-14">
  <% if (state === 'success') { %>
  <div class="overflow-hidden rounded-2xl bg-surface shadow-md">
    <div class="relative bg-sage-100 px-6 pt-8 pb-7 text-center">
      <span class="state-art is-success mx-auto !bg-cream"><%- icon('check','size-10 !stroke-[1.6]') %></span>
      <h1 class="mt-4 font-display text-2xl font-bold">سفارش شما ثبت شد</h1>
      <p class="mt-1 text-sm text-sage-700">پرداخت با موفقیت انجام شد. از خریدتان ممنونیم.</p>
      <p class="mt-4 inline-flex items-center gap-2 rounded-full bg-surface px-4 py-1.5 text-sm">شماره سفارش <b class="ltr tracking-wide text-ink-950"><%= order.OrderNum %></b></p>
    </div>
    <div class="space-y-5 p-5 sm:p-7">
      <dl class="grid grid-cols-2 gap-3 text-sm">
        <div class="rounded-md bg-linen-100 p-3"><dt class="text-xs text-ink-500">مبلغ پرداخت‌شده</dt><dd class="price mt-0.5"><%= price(order.totalPrice) %> <span class="currency">تومان</span></dd></div>
        <div class="rounded-md bg-linen-100 p-3"><dt class="text-xs text-ink-500">کد پیگیری پرداخت</dt><dd class="ltr mt-0.5 text-end font-bold"><%= order.paymentInfo && order.paymentInfo.refId || '—' %></dd></div>
      </dl>
      <div>
        <h2 class="mb-1 text-sm font-bold">خلاصه خرید</h2>
        <ul class="divide-y divide-ink-100 text-sm">
          <% order.products.forEach(function (it) { %>
          <li class="flex justify-between gap-3 py-2.5"><span><%= it.nameAtPurchase %> <span class="block text-xs text-ink-500"><%= [it.selectedSize ? 'سایز ' + it.selectedSize : '', it.selectedColor].filter(Boolean).join(' · ') %> × <%= fa(it.quantity) %></span></span><span class="price shrink-0"><%= price(it.priceAtPurchase * it.quantity) %></span></li>
          <% }) %>
        </ul>
      </div>
      <div class="rounded-lg border border-ink-200 p-4 text-sm">
        <h2 class="mb-3 font-bold">مراحل بعدی</h2>
        <ol class="space-y-3 text-sm leading-6 text-ink-700">
          <li class="flex gap-3"><span class="step-num !size-6 !text-xs">۱</span>سفارش شما آماده و بسته‌بندی می‌شود (<%= settings.dispatchTime %>).</li>
          <li class="flex gap-3"><span class="step-num !size-6 !text-xs">۲</span>کد رهگیری مرسوله در «سفارش‌های من» نمایش داده می‌شود.</li>
          <li class="flex gap-3"><span class="step-num !size-6 !text-xs">۳</span>هزینه ارسال را هنگام تحویل (پس‌کرایه) به مأمور ارسال پرداخت کنید.</li>
        </ol>
        <p class="mt-3 border-t border-ink-100 pt-3 text-xs text-ink-500">ارسال به: <%= order.recipientName %> — <%= order.province %>، <%= order.city %></p>
      </div>
      <div class="flex flex-col gap-2 sm:flex-row">
        <a class="btn btn-dark flex-1" href="/account/orders/<%= order.OrderNum %>">پیگیری سفارش</a>
        <a class="btn btn-outline flex-1" href="/shop">بازگشت به فروشگاه</a>
      </div>
    </div>
  </div>
  <% if (order.needsReview) { %><div class="alert alert-warn mt-4"><%- icon('info','icon-sm mt-1 shrink-0') %>پرداخت شما پس از پایان مهلت رزرو انجام شد. همکاران ما برای هماهنگی موجودی با شما تماس می‌گیرند.</div><% } %>

  <% } else if (state === 'pending') { %>
  <div class="state panel">
    <span class="state-art is-warn"><%- icon('clock','size-10 !stroke-[1.5]') %></span>
    <h1 class="state-title">در انتظار تأیید پرداخت</h1>
    <p class="state-text">نتیجه پرداخت سفارش <b class="ltr inline-block"><%= order.OrderNum %></b> هنوز مشخص نیست. اگر مبلغ از حساب شما کم شده، نگران نباشید؛ وضعیت را دوباره بررسی کنید.</p>
    <div class="mt-2 flex flex-col gap-2 sm:flex-row">
      <% if (order.paymentInfo && order.paymentInfo.authority) { %>
      <a class="btn btn-dark" href="/api/order/verify?Authority=<%= encodeURIComponent(order.paymentInfo.authority) %>&Status=OK"><%- icon('refresh','icon-sm') %> بررسی دوباره</a>
      <% } %>
      <a class="btn btn-outline" href="/contact-us">تماس با پشتیبانی</a>
    </div>
    <p class="text-xs text-ink-500">کالاهای این سفارش تا <%= faDate(order.reservation.expiresAt, { hour: '2-digit', minute: '2-digit' }) %> برای شما رزرو هستند.</p>
  </div>

  <% } else if (state === 'failed') { %>
  <div class="state panel">
    <span class="state-art is-danger"><%- icon('x','size-10 !stroke-[1.5]') %></span>
    <h1 class="state-title">پرداخت انجام نشد</h1>
    <p class="state-text">پرداخت سفارش <b class="ltr inline-block"><%= order.OrderNum %></b> لغو شد یا ناموفق بود. کالاها هنوز در سبد خرید شما هستند و می‌توانید دوباره تلاش کنید.</p>
    <p class="max-w-sm rounded-md bg-linen-100 p-3 text-xs leading-6 text-ink-600">اگر مبلغی از حساب شما کسر شده، طبق قوانین بانکی حداکثر ظرف ۷۲ ساعت به حسابتان برمی‌گردد.</p>
    <div class="mt-2 flex flex-col gap-2 sm:flex-row">
      <a class="btn btn-primary" href="/checkout">تلاش دوباره برای پرداخت</a>
      <a class="btn btn-outline" href="/cart">مشاهده سبد خرید</a>
    </div>
  </div>

  <% } else { %>
  <div class="state panel">
    <span class="state-art"><%- icon('info','size-10 !stroke-[1.5]') %></span>
    <h1 class="state-title">سفارشی پیدا نشد</h1>
    <p class="state-text"><%= user ? 'این سفارش متعلق به حساب شما نیست یا وجود ندارد.' : 'برای دیدن وضعیت سفارش، وارد حساب کاربری شوید.' %></p>
    <div class="mt-2 flex justify-center gap-2">
      <% if (user) { %><a class="btn btn-dark" href="/account/orders">سفارش‌های من</a><% } else { %><button type="button" class="btn btn-dark" data-open-auth>ورود به حساب</button><% } %>
      <a class="btn btn-outline" href="/">صفحه اصلی</a>
    </div>
  </div>
  <% } %>
</div>
<%- include('../partials/layout-bottom') %>
