<%
  var fl = filters;
  var sel = function (list, v) { return list.indexOf(v) !== -1; };
  var removeUrl = function (a) {
    var q = Object.assign({}, query);
    delete q.page; delete q._count;
    if (a.key === 'price') { delete q.min; delete q.max; }
    else if (a.key === 'stock' || a.key === 'sale') { delete q[a.key]; }
    else {
      var cur = [].concat(q[a.key] || []).join(',').split(',').filter(Boolean);
      q[a.key] = cur.filter(function (x) { return x !== a.value; });
    }
    return urlWith(Object.assign(q, {}));
  };
  var clearUrl = basePath + (fl.q ? '?q=' + encodeURIComponent(fl.q) : '');
  var pageUrl = function (n) { var q = Object.assign({}, query); delete q._count; return urlWith(Object.assign(q, { page: n })); };
  var itemList = { '@context': 'https://schema.org', '@type': 'ItemList', itemListElement: products.slice(0, 24).map(function (p, i) { return { '@type': 'ListItem', position: i + 1, url: siteUrl + '/productDetails/' + p.slug }; }) };
  var hexOk = function (h) { return /^#[0-9a-f]{3,8}$/i.test(h || '') ? h : '#eee'; };
%>
<% locals.scripts = ['listing']; locals.jsonld = itemList; %>
<%- include('../partials/layout-top') %>

<!-- Page header -->
<div class="wrap">
  <%- include('../partials/breadcrumbs', { crumbs: crumbs, crumbClass: 'pt-3 pb-1 lg:pt-5' }) %>
  <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-1 pb-1">
    <h1 class="t-page"><%= heading %></h1>
    <p class="pb-1.5 text-sm text-ink-500" aria-live="polite"><b class="font-bold text-ink-950"><%= fa(total) %></b> محصول</p>
  </div>
  <% if (category && category.description && page === 1 && !active.length) { %>
  <p class="mt-1 line-clamp-2 max-w-3xl text-sm leading-7 text-ink-600"><%= category.description.replace(/<[^>]+>/g, '') %></p>
  <% } %>
  <% if (locals.subcategories && subcategories.length) { %>
  <nav class="scroller bleed mt-4" aria-label="زیردسته‌ها">
    <% subcategories.forEach(function (c) { %><a class="chip" href="/category/<%= c.slug %>"><%= c.name %></a><% }) %>
  </nav>
  <% } %>
  <% if (searchPage) { %>
  <form action="/search" method="get" role="search" class="mt-4 flex max-w-xl gap-2">
    <label for="s-q" class="sr-only">عبارت جستجو</label>
    <input id="s-q" name="q" type="search" class="input !rounded-full ps-5" value="<%= fl.q %>" placeholder="جستجوی لباس، سایز، دسته…" enterkeyhint="search">
    <button class="btn btn-dark !h-12 shrink-0" aria-label="جستجو"><%- icon('search','icon-sm') %><span class="hidden sm:inline">جستجو</span></button>
  </form>
  <% } %>
</div>

<!-- Toolbar: sticky on phones so filters and sort stay in reach -->
<div class="sticky z-30 mt-4 border-y border-ink-200 bg-cream/95 backdrop-blur lg:mt-6" style="top: var(--header-h)">
  <div class="wrap flex min-h-14 items-center gap-2 py-1.5">
    <button type="button" class="btn btn-outline btn-sm !h-10 shrink-0 lg:hidden" data-open-filters aria-controls="filters">
      <%- icon('sliders','icon-sm') %> فیلترها<% if (active.length) { %> <span class="inline-flex size-5 items-center justify-center rounded-full bg-ink-950 text-2xs text-cream"><%= fa(active.length) %></span><% } %>
    </button>
    <p class="hidden w-60 shrink-0 items-center gap-2 text-sm font-bold text-ink-950 lg:flex"><%- icon('sliders','icon-sm') %> فیلترها</p>
    <% if (active.length) { %>
    <div class="scroller min-w-0 flex-1 !gap-1.5 py-1" aria-label="فیلترهای فعال">
      <% active.forEach(function (a) { %>
      <a class="chip chip-remove" href="<%= removeUrl(a) %>" aria-label="حذف فیلتر <%= a.label %>"><%= a.label %> <%- icon('x','icon-sm') %></a>
      <% }) %>
      <a class="chip h-9 shrink-0 border-transparent bg-transparent text-ink-600 underline underline-offset-4" href="<%= clearUrl %>">حذف همه</a>
    </div>
    <% } else { %><div class="flex-1"></div><% } %>
    <div class="flex shrink-0 items-center gap-1.5">
      <label for="sort" class="hidden items-center gap-1 text-sm text-ink-500 sm:flex"><%- icon('sort','icon-sm') %>مرتب‌سازی</label>
      <select id="sort" aria-label="مرتب‌سازی محصولات" class="select !h-10 !min-h-10 w-auto !rounded-full !border-ink-200 !py-0 !text-sm font-semibold" data-sort>
        <% Object.keys(sorts).forEach(function (k) { %>
        <option value="<%= k %>" data-url="<%= urlWith({ sort: k === 'newest' ? '' : k, page: '', _count: '' }) %>" <%= fl.sort === k ? 'selected' : '' %>><%= sorts[k] %></option>
        <% }) %>
      </select>
    </div>
  </div>
</div>

<div class="wrap pt-5 lg:grid lg:grid-cols-[15rem_1fr] lg:gap-10 lg:pt-6">
  <!-- Filters: sidebar on desktop, full-height sheet on phones -->
  <aside class="filter-panel" id="filters" data-persistent aria-label="فیلترها" role="dialog" aria-modal="true">
    <form class="sheet" action="<%= basePath %>" method="get" data-filter-form>
      <div class="sheet-grip"></div>
      <div class="sheet-head">
        <h2 class="sheet-title">فیلترها</h2>
        <button type="button" class="icon-btn" data-close-overlay aria-label="بستن فیلترها"><%- icon('x') %></button>
      </div>
      <div class="sheet-body">
        <% if (fl.q) { %><input type="hidden" name="q" value="<%= fl.q %>"><% } %>
        <% if (fl.sort !== 'newest') { %><input type="hidden" name="sort" value="<%= fl.sort %>"><% } %>

        <div class="f-group !pt-0">
          <label class="toggle-row"><span>فقط کالاهای موجود</span><input class="switch" type="checkbox" name="stock" value="1" <%= fl.inStock ? 'checked' : '' %>></label>
          <label class="toggle-row"><span>فقط تخفیف‌دار</span><input class="switch" type="checkbox" name="sale" value="1" <%= fl.onSale ? 'checked' : '' %>></label>
        </div>

        <% if (facets.sizes.length) { %>
        <details class="f-group" open>
          <summary>سایز <%- icon('chevron-down','icon-sm text-ink-400') %></summary>
          <div class="mt-3 grid grid-cols-4 gap-1.5 lg:grid-cols-3">
            <% facets.sizes.forEach(function (s) { %>
            <label class="opt opt-sm"><input type="checkbox" name="size" value="<%= s.value %>" <%= fl.sizes.some(function (x) { return x.trim() === s.value; }) ? 'checked' : '' %>><%= s.value %></label>
            <% }) %>
          </div>
        </details>
        <% } %>

        <% if (!category && facets.categories.length) { %>
        <details class="f-group" open>
          <summary>دسته‌بندی <%- icon('chevron-down','icon-sm text-ink-400') %></summary>
          <div class="mt-2">
            <% facets.categories.forEach(function (c) { %>
            <label class="f-check"><input class="check" type="checkbox" name="cat" value="<%= c.slug %>" <%= sel(fl.cats, c.slug) ? 'checked' : '' %>> <span><%= c.name %></span><span class="f-count"><%= fa(c.count) %></span></label>
            <% }) %>
          </div>
        </details>
        <% } %>

        <% if (facets.colors.length) { %>
        <details class="f-group" open>
          <summary>رنگ <%- icon('chevron-down','icon-sm text-ink-400') %></summary>
          <div class="mt-2 grid grid-cols-2 gap-x-2">
            <% facets.colors.forEach(function (c) { %>
            <label class="f-swatch"><input type="checkbox" name="color" value="<%= c.value %>" <%= sel(fl.colors, c.value) ? 'checked' : '' %>><span class="dot" style="background: <%= hexOk(c.hex) %>"></span><span class="truncate"><%= c.value %></span></label>
            <% }) %>
          </div>
        </details>
        <% } %>

        <% if (facets.priceRange.max > 0) { %>
        <details class="f-group" <%= fl.min !== null || fl.max !== null ? 'open' : '' %>>
          <summary>محدوده قیمت <%- icon('chevron-down','icon-sm text-ink-400') %></summary>
          <div class="mt-3 grid grid-cols-2 gap-2">
            <div class="field"><label class="hint" for="f-min">از (تومان)</label><input id="f-min" class="input !min-h-11 !text-sm" type="text" inputmode="numeric" name="min" value="<%= fl.min !== null ? fl.min : '' %>" placeholder="<%= price(facets.priceRange.min) %>"></div>
            <div class="field"><label class="hint" for="f-max">تا (تومان)</label><input id="f-max" class="input !min-h-11 !text-sm" type="text" inputmode="numeric" name="max" value="<%= fl.max !== null ? fl.max : '' %>" placeholder="<%= price(facets.priceRange.max) %>"></div>
          </div>
          <button type="submit" class="btn btn-outline btn-sm btn-block mt-3 hidden lg:inline-flex">اعمال قیمت</button>
        </details>
        <% } %>

        <% if (facets.brands.length > 1) { %>
        <details class="f-group">
          <summary>برند <%- icon('chevron-down','icon-sm text-ink-400') %></summary>
          <div class="mt-2">
            <% facets.brands.forEach(function (b) { %>
            <label class="f-check"><input class="check" type="checkbox" name="brand" value="<%= b.key %>" <%= sel(fl.brands, b.key) ? 'checked' : '' %>> <span><%= b.name %></span><span class="f-count"><%= fa(b.count) %></span></label>
            <% }) %>
          </div>
        </details>
        <% } %>
        <% if (active.length) { %><a class="btn btn-ghost btn-sm mt-3 hidden text-ink-600 lg:inline-flex" href="<%= clearUrl %>"><%- icon('x','icon-sm') %> حذف همه فیلترها</a><% } %>
        <noscript><button class="btn btn-dark btn-block mt-3">اعمال فیلترها</button></noscript>
      </div>
      <div class="sheet-foot">
        <a class="btn btn-ghost" href="<%= clearUrl %>">پاک کردن</a>
        <button type="submit" class="btn btn-dark flex-1" data-apply><span class="spinner"></span><span class="btn-label-idle">نمایش <span data-count><%= fa(total) %></span> محصول</span></button>
      </div>
    </form>
  </aside>

  <!-- Results -->
  <section aria-labelledby="results-title" class="min-w-0">
    <h2 id="results-title" class="sr-only">نتایج (<%= fa(total) %> محصول)</h2>
    <% if (products.length) { %>
    <div class="pgrid">
      <% products.forEach(function (p, i) { %><%- include('../partials/product-card', { p: p, eager: i < 4, imgSizes: '(min-width: 1280px) 27vw, (min-width: 640px) 31vw, 48vw' }) %><% }) %>
    </div>

    <% if (pages > 1) { %>
    <nav class="mt-12 flex flex-col items-center gap-3" aria-label="صفحه‌بندی">
      <p class="text-xs text-ink-500">صفحه <%= fa(page) %> از <%= fa(pages) %></p>
      <div class="flex items-center gap-1">
        <% if (page > 1) { %><a class="icon-btn border border-ink-200" rel="prev" href="<%= pageUrl(page - 1) %>" aria-label="صفحه قبل"><%- icon('chevron-right','icon-sm') %></a><% } %>
        <% for (var n = 1; n <= pages; n++) { if (n === 1 || n === pages || Math.abs(n - page) <= 1) { %>
          <a class="inline-flex size-11 items-center justify-center rounded-full text-sm font-bold <%= n === page ? 'bg-ink-950 text-cream' : 'text-ink-700 hover:bg-ink-100' %>" href="<%= pageUrl(n) %>" <%- n === page ? 'aria-current="page"' : '' %>><%= fa(n) %></a>
        <% } else if (Math.abs(n - page) === 2) { %><span class="px-1 text-ink-400">…</span><% } } %>
        <% if (page < pages) { %><a class="icon-btn border border-ink-200" rel="next" href="<%= pageUrl(page + 1) %>" aria-label="صفحه بعد"><%- icon('chevron-left','icon-sm') %></a><% } %>
      </div>
    </nav>
    <% } %>
    <% } else { %>
    <div class="state panel-soft">
      <span class="state-art"><%- icon(searchPage ? 'search' : 'hanger', 'size-10 !stroke-[1.4]') %></span>
      <h2 class="state-title"><%= searchPage && fl.q ? 'نتیجه‌ای برای «' + fl.q + '» پیدا نشد' : 'محصولی با این فیلترها پیدا نشد' %></h2>
      <p class="state-text"><%= searchPage ? 'املای دیگری را امتحان کنید یا از کلمه کلی‌تری مثل «تیشرت» یا «سرهمی» استفاده کنید.' : 'چند فیلتر را بردارید یا محدوده قیمت را بازتر کنید تا محصولات بیشتری ببینید.' %></p>
      <div class="mt-2 flex flex-wrap justify-center gap-2">
        <% if (active.length) { %><a class="btn btn-dark" href="<%= clearUrl %>">حذف همه فیلترها</a><% } %>
        <a class="btn btn-outline" href="/shop">دیدن همه محصولات</a>
      </div>
      <% if (menu.length) { %>
      <div class="mt-4 flex flex-wrap justify-center gap-2">
        <% menu.slice(0, 6).forEach(function (c) { %><a class="chip !h-9" href="/category/<%= c.slug %>"><%= c.name %></a><% }) %>
      </div>
      <% } %>
    </div>
    <% } %>
  </section>
</div>

<%- include('../partials/layout-bottom') %>
