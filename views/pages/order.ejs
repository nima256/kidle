<%
  var steps = [['در حال پردازش', 'آماده‌سازی'], ['بسته بندی شده', 'بسته‌بندی'], ['در حال ارسال', 'ارسال'], ['تحویل داده شد', 'تحویل']];
  var paid = order.paymentStatus === 'پرداخت شده';
  var idx = steps.findIndex(function (s) { return s[0] === order.status; });
%>
<%- include('../partials/layout-top') %>
<div class="container-app max-w-3xl py-4">
  <a href="/account/orders" class="btn btn-ghost btn-sm -ms-2 mb-2"><%- icon('arrow-right','icon-sm') %> سفارش‌ها</a>
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h1 class="text-lg font-extrabold">سفارش <span class="ltr"><%= order.OrderNum %></span></h1>
    <%- include('../partials/order-status', { o: order }) %>
  </div>
  <p class="text-xs text-ink-500">ثبت‌شده در <%= faDate(order.createdAt, { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></p>

  <% if (paid && order.status !== 'لغو شده') { %>
  <ol class="card mt-4 grid grid-cols-4 gap-1 p-4" aria-label="وضعیت ارسال">
    <% steps.forEach(function (s, i) { var done = i <= idx; %>
    <li class="relative flex flex-col items-center gap-1.5 text-center text-2xs <%= done ? 'font-bold text-brand-700' : 'text-ink-500' %>" <%- i === idx ? 'aria-current="step"' : '' %>>
      <% if (i > 0) { %><span class="absolute top-3.5 end-1/2 h-0.5 w-full -z-0 <%= done ? 'bg-brand-400' : 'bg-ink-200' %>" aria-hidden="true"></span><% } %>
      <span class="relative z-10 flex size-7 items-center justify-center rounded-full <%= done ? 'bg-brand-600 text-white' : 'bg-ink-100 text-ink-400' %>"><%- icon(done ? 'check' : 'clock', 'icon-sm') %></span><%= s[1] %>
    </li>
    <% }) %>
  </ol>
  <% } else if (order.status === 'در انتظار پرداخت' && !(order.reservation && order.reservation.released)) { %>
  <div class="alert alert-info mt-4"><%- icon('clock','icon-sm mt-0.5') %><span>این سفارش هنوز پرداخت نشده است. <a class="link" href="/checkout/result/<%= order.OrderNum %>">بررسی وضعیت پرداخت</a></span></div>
  <% } else if (!paid) { %>
  <div class="alert alert-warn mt-4"><%- icon('info','icon-sm mt-0.5') %><span>پرداخت این سفارش انجام نشد و سفارش بسته شده است. برای خرید دوباره از <a class="link" href="/cart">سبد خرید</a> اقدام کنید.</span></div>
  <% } %>

  <% if (order.trackingNumber) { %>
  <div class="alert alert-success mt-3"><%- icon('truck','icon-sm mt-0.5') %><span>مرسوله با <b><%= order.delivery %></b> ارسال شد. کد رهگیری: <b class="ltr select-all"><%= order.trackingNumber %></b></span></div>
  <% } %>

  <section class="card mt-4" aria-labelledby="it-title">
    <h2 id="it-title" class="border-b border-ink-100 px-4 py-3 text-sm font-bold">کالاها</h2>
    <ul class="divide-y divide-ink-100 px-4">
      <% order.products.forEach(function (it) { var pr = it.product; %>
      <li class="flex gap-3 py-3">
        <% if (pr && pr.images && pr.images[0]) { %><a href="/productDetails/<%= pr.slug %>" class="w-14 shrink-0" tabindex="-1" aria-hidden="true"><img src="<%= pr.images[0].url %>" alt="" class="aspect-[4/5] w-full rounded-md object-cover" loading="lazy"></a><% } %>
        <div class="min-w-0 flex-1 text-sm">
          <% if (pr && pr.slug) { %><a class="font-semibold hover:text-brand-700" href="/productDetails/<%= pr.slug %>"><%= it.nameAtPurchase %></a><% } else { %><span class="font-semibold"><%= it.nameAtPurchase %></span><% } %>
          <p class="text-xs text-ink-500"><%= [it.selectedSize ? 'سایز ' + it.selectedSize : '', it.selectedColor, fa(it.quantity) + ' عدد'].filter(Boolean).join(' · ') %></p>
        </div>
        <span class="price shrink-0 text-sm"><%= price(it.priceAtPurchase * it.quantity) %></span>
      </li>
      <% }) %>
    </ul>
  </section>

  <div class="mt-4 grid gap-4 sm:grid-cols-2">
    <section class="card card-pad text-sm" aria-labelledby="sh-title">
      <h2 id="sh-title" class="mb-2 font-bold">ارسال</h2>
      <p class="leading-7 text-ink-700"><b><%= order.recipientName || '' %></b> <span class="ltr"><%= order.recipientPhone || '' %></span><br><%= order.province %>، <%= order.city %>، <%= order.address %><%= order.postcode ? '، کد پستی ' + order.postcode : '' %></p>
      <p class="mt-2 text-xs text-ink-500">روش ارسال: <%= order.delivery %> — هزینه ارسال پس‌کرایه</p>
    </section>
    <section class="card card-pad text-sm" aria-labelledby="pay-title">
      <h2 id="pay-title" class="mb-2 font-bold">پرداخت</h2>
      <dl class="space-y-1.5">
        <div class="flex justify-between"><dt class="text-ink-600">جمع کالاها</dt><dd><%= price(order.originalPrice) %></dd></div>
        <% if (order.discountAmount) { %><div class="flex justify-between text-mint-700"><dt>کد تخفیف</dt><dd>−<%= price(order.discountAmount) %></dd></div><% } %>
        <div class="flex justify-between"><dt class="text-ink-600">هزینه ارسال</dt><dd>پس‌کرایه</dd></div>
        <div class="flex justify-between border-t border-ink-100 pt-1.5 font-bold"><dt><%= paid ? 'پرداخت‌شده' : 'مبلغ سفارش' %></dt><dd><%= price(order.totalPrice) %> <span class="currency">تومان</span></dd></div>
        <% if (paid && order.paymentInfo && order.paymentInfo.refId) { %><div class="flex justify-between text-xs text-ink-500"><dt>کد پیگیری</dt><dd class="ltr"><%= order.paymentInfo.refId %></dd></div><% } %>
      </dl>
    </section>
  </div>
  <p class="mt-4 text-center text-xs text-ink-500">سؤالی درباره این سفارش دارید؟ <a class="link" href="/contact-us">با پشتیبانی تماس بگیرید</a></p>
</div>
<%- include('../partials/layout-bottom') %>
