<%
  var steps = [['در حال پردازش', 'آماده‌سازی', 'package'], ['بسته بندی شده', 'بسته‌بندی', 'gift'], ['در حال ارسال', 'ارسال', 'truck'], ['تحویل داده شد', 'تحویل', 'home']];
  var paid = order.paymentStatus === 'پرداخت شده';
  var idx = steps.findIndex(function (s) { return s[0] === order.status; });
%>
<%- include('../partials/layout-top') %>
<div class="wrap max-w-4xl py-5 lg:py-8">
  <a href="/account/orders" class="btn btn-ghost btn-sm -ms-3"><%- icon('arrow-right','icon-sm') %> همه سفارش‌ها</a>
  <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
    <div>
      <p class="text-sm text-ink-500">ثبت‌شده در <%= faDate(order.createdAt, { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></p>
      <h1 class="t-page">سفارش <span class="ltr inline-block font-sans"><%= order.OrderNum %></span></h1>
    </div>
    <%- include('../partials/order-status', { o: order }) %>
  </div>

  <% if (paid && order.status !== 'لغو شده') { %>
  <ol class="panel mt-6 grid grid-cols-4 gap-1 px-3 py-5 sm:px-6" aria-label="وضعیت ارسال">
    <% steps.forEach(function (s, i) { var done = i <= idx; %>
    <li class="relative flex flex-col items-center gap-2 text-center text-xs <%= done ? 'font-bold text-ink-950' : 'text-ink-500' %>" <%- i === idx ? 'aria-current="step"' : '' %>>
      <% if (i > 0) { %><span class="absolute top-5 end-1/2 h-0.5 w-full <%= done ? 'bg-ink-950' : 'bg-ink-200' %>" aria-hidden="true"></span><% } %>
      <span class="relative z-10 flex size-10 items-center justify-center rounded-full <%= i === idx ? 'bg-brand-600 text-white' : done ? 'bg-ink-950 text-cream' : 'bg-ink-100 text-ink-400' %>"><%- icon(done && i < idx ? 'check' : s[2], 'icon-sm') %></span><%= s[1] %>
    </li>
    <% }) %>
  </ol>
  <% } else if (order.status === 'در انتظار پرداخت' && !(order.reservation && order.reservation.released)) { %>
  <div class="alert alert-info mt-6"><%- icon('clock','icon-sm mt-1 shrink-0') %><span>این سفارش هنوز پرداخت نشده است. <a class="link !text-sky-700" href="/checkout/result/<%= order.OrderNum %>">بررسی وضعیت پرداخت</a></span></div>
  <% } else if (!paid) { %>
  <div class="alert alert-warn mt-6"><%- icon('info','icon-sm mt-1 shrink-0') %><span>پرداخت این سفارش انجام نشد و سفارش بسته شده است. برای خرید دوباره از <a class="link !text-warn-700" href="/cart">سبد خرید</a> اقدام کنید.</span></div>
  <% } %>

  <% if (order.trackingNumber) { %>
  <div class="alert alert-success mt-3"><%- icon('truck','icon-sm mt-1 shrink-0') %><span>مرسوله با <b><%= order.delivery %></b> ارسال شد. کد رهگیری: <b class="ltr select-all"><%= order.trackingNumber %></b></span></div>
  <% } %>

  <section class="panel mt-6" aria-labelledby="it-title">
    <h2 id="it-title" class="border-b border-ink-100 px-5 py-4 font-display text-lg font-bold">کالاها</h2>
    <ul class="divide-y divide-ink-100 px-5">
      <% order.products.forEach(function (it) { var pr = it.product; %>
      <li class="flex items-center gap-3 py-4">
        <% if (pr && pr.images && pr.images[0]) { %><a href="/productDetails/<%= pr.slug %>" class="w-16 shrink-0" tabindex="-1" aria-hidden="true"><img src="<%= thumb(pr.images[0].url, 400) %>" alt="" class="aspect-[4/5] w-full rounded-sm bg-linen-100 object-cover" loading="lazy"></a><% } %>
        <div class="min-w-0 flex-1 text-sm">
          <% if (pr && pr.slug) { %><a class="font-semibold text-ink-950 hover:text-brand-700" href="/productDetails/<%= pr.slug %>"><%= it.nameAtPurchase %></a><% } else { %><span class="font-semibold text-ink-950"><%= it.nameAtPurchase %></span><% } %>
          <p class="text-xs text-ink-500"><%= [it.selectedSize ? 'سایز ' + it.selectedSize : '', it.selectedColor, fa(it.quantity) + ' عدد'].filter(Boolean).join(' · ') %></p>
        </div>
        <span class="price shrink-0 text-sm"><%= price(it.priceAtPurchase * it.quantity) %></span>
      </li>
      <% }) %>
    </ul>
  </section>

  <div class="mt-4 grid gap-4 sm:grid-cols-2">
    <section class="panel p-5 text-sm" aria-labelledby="sh-title">
      <h2 id="sh-title" class="mb-2 font-display text-lg font-bold">ارسال</h2>
      <p class="break-anywhere leading-7 text-ink-700"><b class="text-ink-950"><%= order.recipientName || '' %></b> <span class="ltr inline-block"><%= order.recipientPhone || '' %></span><br><%= order.province %>، <%= order.city %>، <%= order.address %><%= order.postcode ? '، کد پستی ' + order.postcode : '' %></p>
      <p class="mt-2 text-xs text-ink-500">روش ارسال: <%= order.delivery %> — هزینه ارسال پس‌کرایه</p>
    </section>
    <section class="panel p-5 text-sm" aria-labelledby="pay-title">
      <h2 id="pay-title" class="mb-2 font-display text-lg font-bold">پرداخت</h2>
      <dl class="space-y-2">
        <div class="flex justify-between"><dt class="text-ink-600">قیمت کالاها</dt><dd><%= price(order.originalPrice) %></dd></div>
        <% if (order.discountAmount) { %><div class="flex justify-between text-brand-700"><dt>کد تخفیف</dt><dd>−<%= price(order.discountAmount) %></dd></div><% } %>
        <div class="flex justify-between"><dt class="text-ink-600">هزینه ارسال</dt><dd>پس‌کرایه</dd></div>
        <div class="flex justify-between border-t border-ink-100 pt-2 font-bold"><dt><%= paid ? 'پرداخت‌شده' : 'مبلغ سفارش' %></dt><dd class="price"><%= price(order.totalPrice) %> <span class="currency">تومان</span></dd></div>
        <% if (paid && order.paymentInfo && order.paymentInfo.refId) { %><div class="flex justify-between text-xs text-ink-500"><dt>کد پیگیری</dt><dd class="ltr"><%= order.paymentInfo.refId %></dd></div><% } %>
      </dl>
    </section>
  </div>
  <p class="mt-6 text-center text-sm text-ink-500">سؤالی درباره این سفارش دارید؟ <a class="link" href="/contact-us">با پشتیبانی تماس بگیرید</a></p>
</div>
<%- include('../partials/layout-bottom') %>
