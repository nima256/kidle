<% locals.scripts = ['checkout']; var P = prefill; %>
<%- include('../partials/layout-top') %>

<div class="wrap max-w-6xl pb-8">
  <ol class="steps pt-4 lg:pt-6" aria-label="مراحل خرید">
    <li class="is-done"><a href="/cart" class="-my-2 flex items-center gap-1.5 py-2"><span class="step-dot"><%- icon('check','size-3.5') %></span>سبد خرید</a></li>
    <li class="step-line" aria-hidden="true"></li>
    <li aria-current="step"><span class="step-dot">۲</span>ارسال</li>
    <li class="step-line" aria-hidden="true"></li>
    <li><span class="step-dot">۳</span>پرداخت</li>
  </ol>
  <h1 class="t-page mt-6 lg:mt-8">اطلاعات ارسال</h1>
  <p class="mt-1 text-sm text-ink-500">دو دقیقه تا ثبت سفارش؛ آدرس شما برای خریدهای بعدی ذخیره می‌شود.</p>

  <form class="mt-6 grid gap-6 lg:grid-cols-[1fr_24rem] lg:items-start lg:gap-12" data-checkout-form novalidate>
    <input type="hidden" name="checkoutKey" value="<%= checkoutKey %>">
    <div class="min-w-0 space-y-6">
      <!-- Summary (collapsed on phones) -->
      <details class="panel group lg:hidden">
        <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-3 px-4 text-sm [&::-webkit-details-marker]:hidden">
          <span class="flex items-center gap-2 font-semibold"><%- icon('bag','icon-sm') %> <%= fa(cart.count) %> کالا در سفارش</span>
          <span class="flex items-center gap-1.5"><span class="price"><%= price(cart.payable) %></span><span class="text-xs text-ink-500">تومان</span> <%- icon('chevron-down','icon-sm transition group-open:rotate-180') %></span>
        </summary>
        <div class="border-t border-ink-100 px-4 pb-2"><%- include('../partials/checkout-items') %></div>
      </details>

      <div class="alert alert-danger" id="error-summary" tabindex="-1" role="alert" hidden>
        <%- icon('alert','icon-sm mt-1 shrink-0') %>
        <div><h2 class="text-sm font-bold !text-danger-700">لطفاً این موارد را اصلاح کنید:</h2><ul class="mt-1 list-disc space-y-0.5 ps-4 text-sm" data-error-list></ul></div>
      </div>
      <% if (cart.issues.length) { %><div class="alert alert-warn"><%- icon('alert','icon-sm mt-1 shrink-0') %><span><%= cart.issues[0] %> — <a class="link" href="/cart">اصلاح سبد</a></span></div><% } %>

      <section class="panel p-5 sm:p-6" aria-labelledby="sec-recipient">
        <h2 id="sec-recipient" class="mb-5 flex items-center gap-3 font-display text-xl font-bold"><span class="step-num">۱</span> تحویل‌گیرنده</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="field">
            <label class="label" for="recipientName">نام و نام خانوادگی <span class="req">*</span></label>
            <input class="input" id="recipientName" name="recipientName" aria-describedby="err-recipientName" autocomplete="name" value="<%= P.recipientName %>" required maxlength="60" enterkeyhint="next">
            <p class="field-error" id="err-recipientName" data-err="recipientName" role="alert" hidden></p>
          </div>
          <div class="field">
            <label class="label" for="recipientPhone">موبایل گیرنده <span class="req">*</span></label>
            <input class="input ltr text-end" id="recipientPhone" name="recipientPhone" aria-describedby="err-recipientPhone" type="tel" inputmode="numeric" autocomplete="tel" value="<%= P.recipientPhone %>" required maxlength="14" enterkeyhint="next" placeholder="09xxxxxxxxx">
            <p class="field-error" id="err-recipientPhone" data-err="recipientPhone" role="alert" hidden></p>
          </div>
        </div>
      </section>

      <section class="panel p-5 sm:p-6" aria-labelledby="sec-address">
        <h2 id="sec-address" class="mb-5 flex items-center gap-3 font-display text-xl font-bold"><span class="step-num">۲</span> آدرس تحویل</h2>
        <% if (hasSaved) { %>
        <div class="choice is-selected mb-1" data-saved-address>
          <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-linen-100 text-ink-950"><%- icon('pin') %></span>
          <div class="min-w-0 flex-1 text-sm leading-7">
            <b class="text-ink-950"><%= P.province %>، <%= P.city %></b>
            <p class="break-anywhere text-ink-600"><%= P.address %><%= P.postcode ? ' — کد پستی ' + P.postcode : '' %></p>
          </div>
          <button type="button" class="btn btn-ghost btn-sm shrink-0 underline underline-offset-4" data-edit-address>ویرایش</button>
        </div>
        <% } %>
        <div class="grid gap-4 sm:grid-cols-2" data-address-fields <%= hasSaved ? 'hidden' : '' %>>
          <div class="field">
            <label class="label" for="province">استان <span class="req">*</span></label>
            <select class="select" id="province" name="province" aria-describedby="err-province" required autocomplete="address-level1">
              <option value="">انتخاب استان</option>
              <% Object.keys(provinces).forEach(function (pv) { %><option value="<%= pv %>" <%= P.province === pv ? 'selected' : '' %>><%= pv %></option><% }) %>
            </select>
            <p class="field-error" id="err-province" data-err="province" role="alert" hidden></p>
          </div>
          <div class="field">
            <label class="label" for="city">شهر <span class="req">*</span></label>
            <input class="input" id="city" name="city" aria-describedby="err-city" list="city-list" value="<%= P.city %>" required maxlength="40" autocomplete="address-level2" placeholder="نام شهر">
            <datalist id="city-list"></datalist>
            <p class="field-error" id="err-city" data-err="city" role="alert" hidden></p>
          </div>
          <div class="field sm:col-span-2">
            <label class="label" for="address">آدرس دقیق <span class="req">*</span></label>
            <textarea class="textarea !min-h-24" id="address" name="address" aria-describedby="err-address" rows="2" required maxlength="500" autocomplete="street-address" placeholder="خیابان، کوچه، پلاک، واحد"><%= P.address %></textarea>
            <p class="field-error" id="err-address" data-err="address" role="alert" hidden></p>
          </div>
          <div class="field">
            <label class="label" for="postcode">کد پستی <span class="opt-note">(اختیاری)</span></label>
            <input class="input ltr text-end" id="postcode" name="postcode" aria-describedby="err-postcode" inputmode="numeric" maxlength="10" autocomplete="postal-code" value="<%= P.postcode %>" placeholder="۱۰ رقم">
            <p class="field-error" id="err-postcode" data-err="postcode" role="alert" hidden></p>
          </div>
        </div>
      </section>

      <section class="panel p-5 sm:p-6" aria-labelledby="sec-ship">
        <h2 id="sec-ship" class="mb-5 flex items-center gap-3 font-display text-xl font-bold"><span class="step-num">۳</span> ارسال و پرداخت</h2>
        <div class="space-y-2.5">
          <div class="choice">
            <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-linen-100 text-ink-950"><%- icon('truck') %></span>
            <div class="text-sm leading-6"><b class="text-ink-950">ارسال پس‌کرایه</b><p class="text-xs leading-6 text-ink-600"><%= settings.shippingNote %> <%= settings.dispatchTime %>.</p></div>
          </div>
          <div class="choice is-selected">
            <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-brand-50 text-brand-700"><%- icon('card') %></span>
            <div class="text-sm leading-6"><b class="text-ink-950">پرداخت آنلاین مبلغ کالاها</b><p class="text-xs leading-6 text-ink-600">با همه کارت‌های عضو شتاب، از طریق درگاه امن زرین‌پال.</p></div>
            <%- icon('check-circle','ms-auto shrink-0 text-ink-950') %>
          </div>
        </div>
      </section>
    </div>

    <aside class="space-y-3 lg:sticky lg:top-[calc(var(--header-h)+1.5rem)]">
      <div class="panel p-5 sm:p-6">
        <h2 class="mb-2 hidden font-display text-xl font-bold lg:block">سفارش شما</h2>
        <div class="hidden max-h-72 overflow-y-auto lg:block"><%- include('../partials/checkout-items') %></div>
        <dl class="space-y-2.5 text-sm lg:mt-3 lg:border-t lg:border-ink-100 lg:pt-4">
          <div class="flex justify-between"><dt class="text-ink-600">قیمت کالاها</dt><dd><%= price(cart.subtotal + cart.productSavings) %> <span class="currency">تومان</span></dd></div>
          <% if (cart.productSavings) { %><div class="flex justify-between text-brand-700"><dt>تخفیف محصولات</dt><dd>−<%= price(cart.productSavings) %></dd></div><% } %>
          <% if (cart.discount) { %><div class="flex justify-between text-brand-700"><dt>کد <span class="ltr"><%= cart.discount.code %></span></dt><dd>−<%= price(cart.discountAmount) %></dd></div><% } %>
          <div class="flex justify-between"><dt class="text-ink-600">هزینه ارسال</dt><dd>پس‌کرایه (هنگام تحویل)</dd></div>
          <div class="rule-dashed !my-3"></div>
          <div class="flex items-end justify-between"><dt class="font-bold">پرداخت آنلاین</dt><dd class="price text-xl leading-none"><%= price(cart.payable) %> <span class="currency">تومان</span></dd></div>
        </dl>
        <button type="submit" class="btn btn-primary btn-lg btn-block mt-5 hidden lg:inline-flex" data-pay <%= cart.canCheckout ? '' : 'disabled' %>><span class="spinner"></span><span class="btn-label-idle flex items-center gap-2"><%- icon('lock','icon-sm') %> پرداخت <%= price(cart.payable) %> تومان</span></button>
        <p class="mt-3 hidden text-center text-xs leading-6 text-ink-500 lg:block">پس از کلیک به درگاه زرین‌پال منتقل می‌شوید. با پرداخت، <a class="link" href="/terms-and-conditions" target="_blank">قوانین</a> را می‌پذیرید.</p>
      </div>
      <p class="flex items-center justify-center gap-1.5 text-xs text-ink-500"><%- icon('shield','icon-sm text-sage-700') %> اطلاعات کارت شما نزد کیدل ذخیره نمی‌شود</p>
    </aside>

    <div class="action-bar lg:hidden">
      <button type="submit" class="btn btn-primary btn-lg btn-block" data-pay <%= cart.canCheckout ? '' : 'disabled' %>><span class="spinner"></span><span class="btn-label-idle flex items-center gap-2"><%- icon('lock','icon-sm') %> پرداخت <%= price(cart.payable) %> تومان</span></button>
      <p class="mt-1.5 text-center text-2xs text-ink-500">انتقال به درگاه امن زرین‌پال · ارسال پس‌کرایه</p>
    </div>
  </form>
</div>
<script type="application/json" id="cities-data"><%- json(provinces) %></script>
<%- include('../partials/layout-bottom') %>
