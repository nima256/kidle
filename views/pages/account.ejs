<% locals.scripts = ['account']; %>
<%- include('../partials/layout-top') %>
<div class="bg-linen-100">
  <div class="wrap max-w-5xl py-6 lg:py-10">
    <div class="flex items-center gap-4">
      <span class="arch flex h-16 w-14 shrink-0 items-center justify-center bg-brand-600 font-display text-2xl font-bold text-white"><%= (profile.fullName || 'ک').trim().charAt(0) %></span>
      <div class="min-w-0">
        <p class="text-sm text-ink-500">سلام،</p>
        <h1 class="t-page truncate"><%= profile.fullName || 'کاربر کیدل' %></h1>
        <p class="ltr text-end text-sm text-ink-500"><%= profile.mobile %></p>
      </div>
    </div>
    <div class="mt-6"><%- include('../partials/account-nav') %></div>
  </div>
</div>
<div class="wrap max-w-5xl py-6 lg:py-10">
  <div class="grid gap-6 md:grid-cols-[1fr_1.1fr]">
    <section class="panel p-5 sm:p-6" aria-labelledby="pf-title">
      <h2 id="pf-title" class="font-display text-xl font-bold">اطلاعات شخصی</h2>
      <form class="mt-5 space-y-4" data-profile-form novalidate>
        <div class="field"><label class="label" for="pf-name">نام و نام خانوادگی</label><input id="pf-name" name="fullName" class="input" value="<%= profile.fullName %>" maxlength="60" autocomplete="name"><p class="field-error" data-err="fullName" hidden></p></div>
        <div class="field"><label class="label" for="pf-mobile">شماره موبایل</label><input id="pf-mobile" class="input ltr text-end" value="<%= profile.mobile %>" readonly aria-describedby="pf-mobile-hint"><p id="pf-mobile-hint" class="hint">ورود شما با همین شماره انجام می‌شود.</p></div>
        <div class="field"><label class="label" for="pf-email">ایمیل <span class="opt-note">(اختیاری)</span></label><input id="pf-email" name="email" type="email" class="input ltr text-end" value="<%= profile.email || '' %>" autocomplete="email"><p class="field-error" data-err="email" hidden></p></div>
        <button class="btn btn-dark"><span class="spinner"></span><span class="btn-label-idle">ذخیره تغییرات</span></button>
      </form>
    </section>

    <div class="space-y-6">
      <section class="panel p-5 sm:p-6" aria-labelledby="ro-title">
        <div class="flex items-center justify-between gap-2"><h2 id="ro-title" class="font-display text-xl font-bold">آخرین سفارش‌ها</h2><% if (orders.length) { %><a class="see-all" href="/account/orders"><span>همه</span><%- icon('arrow-left','icon-sm') %></a><% } %></div>
        <% if (orders.length) { %>
        <ul class="mt-3 divide-y divide-ink-100">
          <% orders.forEach(function (o) { %>
          <li><a class="flex min-h-16 items-center justify-between gap-3 py-2 text-sm hover:text-brand-700" href="/account/orders/<%= o.OrderNum %>"><span><b class="ltr inline-block text-ink-950"><%= o.OrderNum %></b><span class="block text-xs text-ink-500"><%= faDate(o.createdAt) %></span></span><span class="flex items-center gap-2"><%- include('../partials/order-status', { o: o }) %><%- icon('chevron-left','icon-sm text-ink-400') %></span></a></li>
          <% }) %>
        </ul>
        <% } else { %>
        <div class="mt-4 rounded-md bg-linen-100 p-4 text-sm leading-7 text-ink-600">هنوز سفارشی ثبت نکرده‌اید. <a class="link" href="/shop?sort=newest">دیدن تازه‌ها</a></div>
        <% } %>
      </section>
      <section class="panel p-5 sm:p-6" aria-labelledby="ad-title">
        <h2 id="ad-title" class="font-display text-xl font-bold">آدرس پیش‌فرض</h2>
        <% if (profile.savedAddress && profile.savedAddress.address) { var a = profile.savedAddress; %>
        <div class="mt-3 flex items-start gap-3 text-sm leading-7 text-ink-700"><%- icon('pin','mt-1 shrink-0 text-ink-400') %><p class="break-anywhere"><b class="text-ink-950"><%= a.recipientName %></b> — <span class="ltr inline-block"><%= a.recipientPhone %></span><br><%= a.province %>، <%= a.city %>، <%= a.address %><%= a.postcode ? '، کد پستی ' + a.postcode : '' %></p></div>
        <p class="hint mt-2">در خرید بعدی خودکار پر می‌شود و هنگام پرداخت قابل ویرایش است.</p>
        <% } else { %><p class="mt-3 text-sm leading-7 text-ink-600">هنوز آدرسی ثبت نکرده‌اید. در اولین خرید، آدرس شما برای دفعات بعد ذخیره می‌شود.</p><% } %>
      </section>
    </div>
  </div>
  <div class="mt-8 flex flex-col items-start justify-between gap-3 border-t border-ink-200 pt-6 sm:flex-row sm:items-center">
    <p class="text-sm text-ink-600">می‌خواهید از حساب خود در این دستگاه خارج شوید؟</p>
    <button type="button" class="btn btn-danger btn-sm shrink-0" data-logout><span class="spinner"></span><span class="btn-label-idle flex items-center gap-1.5"><%- icon('logout','icon-sm') %> خروج از حساب</span></button>
  </div>
</div>
<%- include('../partials/layout-bottom') %>
