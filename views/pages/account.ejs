<% locals.scripts = ['account']; %>
<%- include('../partials/layout-top') %>
<div class="container-app max-w-4xl py-4">
  <div class="mb-4 flex items-center gap-3">
    <span class="flex size-12 items-center justify-center rounded-full bg-brand-100 text-lg font-black text-brand-700"><%= (profile.fullName || 'ک').trim().charAt(0) %></span>
    <div>
      <h1 class="text-lg font-extrabold"><%= profile.fullName || 'کاربر کیدل' %></h1>
      <p class="ltr text-end text-sm text-ink-500"><%= profile.mobile %></p>
    </div>
  </div>
  <%- include('../partials/account-nav') %>

  <div class="grid gap-4 md:grid-cols-2">
    <section class="card card-pad" aria-labelledby="pf-title">
      <h2 id="pf-title" class="mb-3 text-base font-bold">اطلاعات شخصی</h2>
      <form class="space-y-3" data-profile-form novalidate>
        <div class="field"><label class="label" for="pf-name">نام و نام خانوادگی</label><input id="pf-name" name="fullName" class="input" value="<%= profile.fullName %>" maxlength="60" autocomplete="name"><p class="field-error" data-err="fullName" hidden></p></div>
        <div class="field"><label class="label" for="pf-mobile">شماره موبایل</label><input id="pf-mobile" class="input ltr text-end" value="<%= profile.mobile %>" readonly aria-describedby="pf-mobile-hint"><p id="pf-mobile-hint" class="hint">ورود شما با همین شماره انجام می‌شود.</p></div>
        <div class="field"><label class="label" for="pf-email">ایمیل <span class="text-xs font-normal text-ink-500">(اختیاری)</span></label><input id="pf-email" name="email" type="email" class="input ltr text-end" value="<%= profile.email || '' %>" autocomplete="email"><p class="field-error" data-err="email" hidden></p></div>
        <button class="btn btn-primary"><span class="spinner"></span><span class="btn-label-idle">ذخیره تغییرات</span></button>
      </form>
    </section>

    <div class="space-y-4">
      <section class="card card-pad" aria-labelledby="ad-title">
        <h2 id="ad-title" class="mb-2 text-base font-bold">آدرس پیش‌فرض</h2>
        <% if (profile.savedAddress && profile.savedAddress.address) { var a = profile.savedAddress; %>
        <p class="text-sm leading-7 text-ink-700"><b><%= a.recipientName %></b> — <span class="ltr"><%= a.recipientPhone %></span><br><%= a.province %>، <%= a.city %>، <%= a.address %><%= a.postcode ? '، کد پستی ' + a.postcode : '' %></p>
        <p class="hint mt-1">در خرید بعدی به‌صورت خودکار پر می‌شود و در صفحه پرداخت قابل ویرایش است.</p>
        <% } else { %><p class="text-sm text-ink-600">هنوز آدرسی ثبت نکرده‌اید. در اولین خرید، آدرس شما برای دفعات بعد ذخیره می‌شود.</p><% } %>
      </section>

      <section class="card card-pad" aria-labelledby="ro-title">
        <div class="mb-2 flex items-center justify-between"><h2 id="ro-title" class="text-base font-bold">آخرین سفارش‌ها</h2><a class="btn btn-ghost btn-sm text-brand-700" href="/account/orders">همه</a></div>
        <% if (orders.length) { %>
        <ul class="divide-y divide-ink-100">
          <% orders.forEach(function (o) { %>
          <li><a class="flex items-center justify-between gap-2 py-2.5 text-sm hover:text-brand-700" href="/account/orders/<%= o.OrderNum %>"><span><b class="ltr"><%= o.OrderNum %></b><span class="block text-2xs text-ink-500"><%= faDate(o.createdAt) %></span></span><%- include('../partials/order-status', { o: o }) %></a></li>
          <% }) %>
        </ul>
        <% } else { %><p class="text-sm text-ink-600">هنوز سفارشی ثبت نکرده‌اید. <a class="link" href="/shop">شروع خرید</a></p><% } %>
      </section>
    </div>
  </div>
</div>
<%- include('../partials/layout-bottom') %>
