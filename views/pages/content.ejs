<%- include('../partials/layout-top') %>
<div class="bg-linen-100">
  <div class="wrap max-w-4xl pb-10 lg:pb-14">
    <%- include('../partials/breadcrumbs', { crumbs: [{ name: page.title }], crumbClass: 'pt-3 pb-4 lg:pt-5' }) %>
    <p class="eyebrow"><%= page.kicker %></p>
    <h1 class="t-display mt-2 !text-[clamp(2rem,1.5rem+2vw,3rem)]"><%= page.title %></h1>
    <p class="lead mt-4 max-w-2xl"><%= page.lead %></p>
  </div>
</div>
<div class="wrap max-w-4xl py-8 lg:py-12">
  <% (page.sections || []).forEach(function (s) { %>
  <section class="mb-8 grid gap-2 lg:grid-cols-[14rem_1fr] lg:gap-10">
    <% if (s.title) { %><h2 class="font-display text-xl font-bold"><%= s.title %></h2><% } else { %><span></span><% } %>
    <div><% s.body.forEach(function (b) { %><p class="mb-3 text-[0.9375rem] leading-8 text-ink-800"><%= b %></p><% }) %></div>
  </section>
  <% }) %>

  <% if (page.features) { %>
  <ul class="mt-4 grid gap-3 sm:grid-cols-2">
    <% page.features.forEach(function (f) { %>
    <li class="flex items-start gap-4 rounded-lg bg-surface p-5 ring-1 ring-ink-200"><span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-brand-50 text-brand-700"><%- icon(f.icon) %></span><div><h3 class="font-display text-base font-bold"><%= f.title %></h3><p class="mt-0.5 text-sm leading-7 text-ink-600"><%= f.text %></p></div></li>
    <% }) %>
  </ul>
  <% } %>
  <% if (page.closing) { %><p class="mt-10 text-center font-display text-2xl font-bold text-brand-700"><%= page.closing %></p><% } %>

  <% if (page.contact) { %>
  <ul class="mt-4 grid gap-3 sm:grid-cols-2">
    <li><a class="flex items-center gap-4 rounded-lg bg-surface p-5 ring-1 ring-ink-200 transition hover:ring-ink-950" href="tel:<%= settings.phone %>"><span class="flex size-11 items-center justify-center rounded-full bg-linen-100 text-ink-950"><%- icon('phone') %></span><span class="text-sm"><b class="block text-ink-950">تلفن و پشتیبانی</b><span class="ltr inline-block text-ink-600"><%= settings.phone %></span><span class="block text-xs text-ink-500"><%= settings.workingHours %></span></span></a></li>
    <li><a class="flex items-center gap-4 rounded-lg bg-surface p-5 ring-1 ring-ink-200 transition hover:ring-ink-950" href="mailto:<%= settings.email %>"><span class="flex size-11 items-center justify-center rounded-full bg-linen-100 text-ink-950"><%- icon('mail') %></span><span class="min-w-0 text-sm"><b class="block text-ink-950">ایمیل</b><span class="break-anywhere text-ink-600"><%= settings.email %></span></span></a></li>
    <% if (settings.instagram) { %><li><a class="flex items-center gap-4 rounded-lg bg-surface p-5 ring-1 ring-ink-200 transition hover:ring-ink-950" href="https://instagram.com/<%= settings.instagram %>" target="_blank" rel="noopener"><span class="flex size-11 items-center justify-center rounded-full bg-linen-100 text-ink-950"><%- icon('instagram') %></span><span class="text-sm"><b class="block text-ink-950">اینستاگرام</b><span class="ltr inline-block text-ink-600">@<%= settings.instagram %></span></span></a></li><% } %>
    <% if (settings.telegram) { %><li><a class="flex items-center gap-4 rounded-lg bg-surface p-5 ring-1 ring-ink-200 transition hover:ring-ink-950" href="https://t.me/<%= settings.telegram %>" target="_blank" rel="noopener"><span class="flex size-11 items-center justify-center rounded-full bg-linen-100 text-ink-950"><%- icon('send') %></span><span class="text-sm"><b class="block text-ink-950">تلگرام</b><span class="ltr inline-block text-ink-600">@<%= settings.telegram %></span></span></a></li><% } %>
    <li class="sm:col-span-2"><div class="flex items-center gap-4 rounded-lg bg-surface p-5 ring-1 ring-ink-200"><span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-linen-100 text-ink-950"><%- icon('pin') %></span><span class="text-sm"><b class="block text-ink-950">آدرس فروشگاه</b><span class="text-ink-600"><%= settings.address %></span></span></div></li>
  </ul>
  <% } %>
  <% if (page.updated) { %><p class="mt-8 text-xs text-ink-500">آخرین به‌روزرسانی: <%= page.updated %></p><% } %>
</div>
<%- include('../partials/layout-bottom') %>
