<%- include('../partials/layout-top') %>
<section class="wrap py-12 sm:py-20">
  <div class="mx-auto flex max-w-lg flex-col items-center text-center">
    <% if (status === 404) { %>
    <div class="relative" aria-hidden="true">
      <span class="arch flex h-40 w-32 items-end justify-center bg-linen-100 pb-6 text-ink-800"><%- icon('hanger','size-16 !stroke-[1.2]') %></span>
      <span class="absolute -top-2 -end-6 flex size-14 items-center justify-center rounded-full bg-brand-600 text-lg font-extrabold text-white">۴۰۴</span>
    </div>
    <h1 class="t-page mt-6">این صفحه پیدا نشد</h1>
    <p class="mt-2 text-[0.9375rem] leading-8 text-ink-600"><%= locals.message && message !== 'پیدا نشد' ? message : 'ممکن است آدرس اشتباه باشد یا این صفحه جابه‌جا شده باشد.' %></p>
    <% } else { %>
    <span class="state-art is-danger"><%- icon('alert','size-10 !stroke-[1.5]') %></span>
    <h1 class="t-page mt-6"><%= status >= 500 ? 'مشکلی پیش آمد' : 'درخواست انجام نشد' %></h1>
    <p class="mt-2 text-[0.9375rem] leading-8 text-ink-600"><%= locals.message || 'لطفاً چند لحظه دیگر دوباره تلاش کنید. اگر مشکل ادامه داشت با پشتیبانی تماس بگیرید.' %></p>
    <% } %>
    <form action="/search" method="get" class="mt-7 flex w-full gap-2" role="search">
      <label for="err-q" class="sr-only">جستجو</label>
      <input id="err-q" name="q" class="input !rounded-full ps-5" placeholder="جستجوی محصول…" enterkeyhint="search">
      <button class="btn btn-dark !h-12 shrink-0">جستجو</button>
    </form>
    <div class="mt-4 flex gap-2">
      <a href="/" class="btn btn-outline">صفحه اصلی</a>
      <a href="/shop" class="btn btn-ghost">همه محصولات</a>
    </div>
  </div>
</section>
<%- include('../partials/layout-bottom') %>
