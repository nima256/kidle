<% locals.scripts = ['cart']; %>
<%- include('../partials/layout-top') %>
<div class="wrap pb-6">
  <ol class="steps pt-4 lg:pt-6" aria-label="مراحل خرید">
    <li aria-current="step"><span class="step-dot">۱</span>سبد خرید</li>
    <li class="step-line" aria-hidden="true"></li>
    <li><span class="step-dot">۲</span>ارسال</li>
    <li class="step-line" aria-hidden="true"></li>
    <li><span class="step-dot">۳</span>پرداخت</li>
  </ol>
  <div class="flex items-end justify-between gap-3 pt-6 pb-4 lg:pt-8">
    <h1 class="t-page">سبد خرید <span class="font-sans text-base font-medium text-ink-500" data-cart-title-count><%= cart.count ? '(' + fa(cart.count) + ' کالا)' : '' %></span></h1>
    <a href="/shop" class="see-all hidden sm:inline-flex"><span>ادامه خرید</span><%- icon('arrow-left','icon-sm') %></a>
  </div>
  <div id="cart-root" data-logged-in="<%= user ? '1' : '' %>">
    <div class="grid gap-6 lg:grid-cols-[1fr_24rem]" aria-hidden="true">
      <div class="space-y-4"><div class="skeleton h-32"></div><div class="skeleton h-32"></div></div>
      <div class="skeleton h-72"></div>
    </div>
  </div>
  <noscript><div class="alert alert-warn">برای استفاده از سبد خرید، جاوااسکریپت مرورگر را فعال کنید.</div></noscript>
</div>
<script type="application/json" id="cart-data"><%- json(cart) %></script>
<%- include('../partials/layout-bottom') %>
