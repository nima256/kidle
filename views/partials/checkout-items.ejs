<ul class="divide-y divide-ink-100">
  <% cart.items.forEach(function (it) { %>
  <li class="flex items-center gap-3 py-3">
    <span class="relative w-14 shrink-0">
      <% if (it.image) { %><img src="<%= it.image %>" alt="" class="aspect-[4/5] w-full rounded-sm bg-linen-100 object-cover" loading="lazy"><% } else { %><span class="block aspect-[4/5] w-full rounded-sm bg-linen-100"></span><% } %>
      <span class="absolute -top-2 -start-2 flex size-5.5 items-center justify-center rounded-full bg-ink-950 text-2xs font-bold text-cream ring-2 ring-surface"><%= fa(it.quantity) %></span>
    </span>
    <span class="min-w-0 flex-1 text-sm leading-6">
      <span class="line-clamp-2 font-semibold text-ink-900"><%= it.name %></span>
      <span class="text-xs text-ink-500"><%= [it.selectedSize ? 'سایز ' + it.selectedSize : '', it.selectedColor].filter(Boolean).join(' · ') %></span>
    </span>
    <span class="price shrink-0 text-sm"><%= price(it.lineTotal) %></span>
  </li>
  <% }) %>
</ul>
