<ul class="divide-y divide-ink-100">
  <% cart.items.forEach(function (it) { %>
  <li class="flex gap-2.5 py-2.5">
    <span class="relative w-12 shrink-0">
      <% if (it.image) { %><img src="<%= it.image %>" alt="" class="aspect-[4/5] w-full rounded-md bg-ink-100 object-cover" loading="lazy"><% } %>
      <span class="absolute -top-1.5 -start-1.5 flex size-5 items-center justify-center rounded-full bg-night-800 text-2xs font-bold text-white"><%= fa(it.quantity) %></span>
    </span>
    <span class="min-w-0 flex-1 text-xs leading-5">
      <span class="line-clamp-2 font-semibold text-ink-900"><%= it.name %></span>
      <span class="text-ink-500"><%= [it.selectedSize ? 'سایز ' + it.selectedSize : '', it.selectedColor].filter(Boolean).join(' · ') %></span>
    </span>
    <span class="price shrink-0 text-xs"><%= price(it.lineTotal) %></span>
  </li>
  <% }) %>
</ul>
