<!-- ==================== فوتر ==================== -->
<%- include('./partials/footer') %>


<script>
// ==================== دیتای مقالات ====================
let posts = [];
let currentCategory = "all";
let currentPost = null;

// ==================== توابع کمکی ====================
function toPersianNumber(num) {
  const digits = ['۰','۱','۲','۳','۴','۵','۶','۷','۸','۹'];
  return num.toString().replace(/\d/g, d => digits[parseInt(d)]);
}

function toPersianDate(dateString) {
  if (!dateString) return '';
  const date = new Date(dateString);
  return date.toLocaleDateString('fa-IR');
}

async function fetchCategories() {
  try {
    const response = await fetch('/api/weblog/categories');
    const data = await response.json();
    if (data.success) {
      return data.categories;
    }
    return [];
  } catch (error) {
    console.error('Error fetching categories:', error);
    return [];
  }
}

async function fetchLatestPosts() {
  try {
    const response = await fetch('/api/weblog/latest');
    const data = await response.json();
    if (data.success) {
      return data.posts;
    }
    return [];
  } catch (error) {
    console.error('Error fetching latest posts:', error);
    return [];
  }
}

async function fetchPostsByCategory(category) {
  try {
    const url = category === 'all' 
      ? '/api/weblog/latest' 
      : `/api/weblog/posts?category=${category}`;
    const response = await fetch(url);
    const data = await response.json();
    if (data.success) {
      return data.posts;
    }
    return [];
  } catch (error) {
    console.error('Error fetching posts:', error);
    return [];
  }
}

async function fetchSinglePost(slug) {
  try {
    const response = await fetch(`/api/weblog/post/${slug}`);
    const data = await response.json();
    if (data.success) {
      return { post: data.post, relatedPosts: data.relatedPosts };
    }
    return null;
  } catch (error) {
    console.error('Error fetching post:', error);
    return null;
  }
}

async function fetchStats() {
  try {
    const response = await fetch('/api/weblog/stats');
    const data = await response.json();
    if (data.success) {
      document.getElementById('stat-articles').textContent = toPersianNumber(data.stats.articles);
      document.getElementById('stat-satisfaction').textContent = `${toPersianNumber(data.stats.satisfaction)}٪`;
      document.getElementById('stat-writers').textContent = toPersianNumber(data.stats.writers);
      document.getElementById('stat-comments').textContent = toPersianNumber(data.stats.comments);
    }
  } catch (error) {
    console.error('Error fetching stats:', error);
  }
}

async function renderCategories() {
  const categories = await fetchCategories();
  const categoriesContainer = document.querySelector('.chip-scroll');
  if (!categoriesContainer) return;
  
  let categoriesHtml = `
    <button class="category-chip active px-5 py-2.5 rounded-full bg-pink-500 text-white font-bold whitespace-nowrap shadow-md" data-cat="all">همه</button>
  `;
  
  categories.forEach(cat => {
    categoriesHtml += `
      <button class="category-chip px-5 py-2.5 rounded-full bg-white/70 text-rose-700 font-bold whitespace-nowrap hover:bg-white transition" data-cat="${cat.name}">
        ${cat.name}
      </button>
    `;
  });
  
  categoriesContainer.innerHTML = categoriesHtml;
  setupCategories();
}


// ==================== نمایش مقالات در صفحه اصلی ====================
async function renderArticles() {
  const grid = document.getElementById("articles-grid");
  if (!grid) return;
  
  const skeleton = document.getElementById("skeleton-grid");
  if (skeleton) skeleton.classList.remove("hidden");
  if (grid) grid.classList.add("hidden");
  
  const filtered = await fetchPostsByCategory(currentCategory);
  posts = filtered;
  
  if (skeleton) skeleton.classList.add("hidden");
  if (grid) grid.classList.remove("hidden");
  
  grid.innerHTML = "";
  
  filtered.forEach(post => {
    const card = document.createElement("div");
    const categoryName = post.categories && post.categories[0] ? post.categories[0].name : 'عمومی';
    const authorName = post.authorDetails ? post.authorDetails.fullName : 'کیدل مگ';
    const imageIcon = post.images && post.images[0] ? 
      `<img src="${post.images[0].url}" class="w-full h-full object-cover rounded-xl">` : 
      `<i class="fas fa-tshirt text-5xl text-pink-400"></i>`;
    
    card.className = "article-card rounded-2xl p-3 shadow-sm fade-in";
    card.innerHTML = `
      <div class="image-placeholder rounded-xl h-44 flex items-center justify-center overflow-hidden">
        ${imageIcon}
      </div>
      <div class="pt-4">
        <div class="flex flex-wrap gap-2 mb-2">
          <span class="bg-pink-100 text-pink-600 text-xs font-bold px-3 py-1 rounded-full">${categoryName}</span>
          <span class="bg-amber-50 text-rose-600 text-xs font-bold px-3 py-1 rounded-full"><i class="far fa-clock ml-1"></i> ${toPersianNumber(post.readingTime)} دقیقه</span>
        </div>
        <h3 class="font-extrabold text-rose-800 text-base leading-6 line-clamp-2 min-h-[48px]">${post.title}</h3>
        <div class="flex gap-3 text-xs text-rose-500 mt-2">
          <span><i class="far fa-calendar ml-1"></i> ${toPersianDate(post.publishedAt)}</span>
          <span><i class="far fa-user ml-1"></i> ${authorName}</span>
        </div>
        <p class="text-sm text-rose-600 mt-2 line-clamp-3">${post.description}</p>
        <a href="/weblog/${post.slug}" class="read-more-link block w-full mt-3 bg-pink-500 hover:bg-pink-600 text-white font-bold py-2.5 rounded-xl transition text-center">
          ادامه مطلب <i class="fas fa-arrow-left mr-1"></i>
        </a>
      </div>
    `;
    grid.appendChild(card);
  });
}

// ==================== نمایش صفحه تکی مقاله با نوار ناوبری ====================
async function showSinglePost(slug) {
  const data = await fetchSinglePost(slug);
  if (!data) return;
  
  const post = data.post;
  const relatedPosts = data.relatedPosts;
  currentPost = post;
  
  const categoryName = post.categories && post.categories[0] ? post.categories[0].name : 'عمومی';
  const authorName = post.authorDetails ? post.authorDetails.fullName : 'کیدل مگ';
  const mainImage = post.images && post.images[0] ? 
    `<img src="${post.images[0].url}" class="w-full h-full object-cover rounded-2xl" title="${post.images[0].caption}">` : 
    `<i class="fas fa-tshirt text-7xl text-pink-400"></i>`;
  
  const content = `
    <div class="grid lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2">
        <div class="bg-white rounded-3xl p-5 shadow-xl border border-rose-100">
          <div class="image-placeholder rounded-2xl h-64 flex items-center justify-center overflow-hidden">
            ${mainImage}
          </div>
          <div id="postTOC" class="mb-6"></div>
          <div class="mt-6">
            <div class="flex flex-wrap gap-2 mb-4">
              <span class="bg-pink-100 text-pink-600 text-xs font-bold px-3 py-1 rounded-full">${categoryName}</span>
              <span class="bg-amber-50 text-rose-600 text-xs font-bold px-3 py-1 rounded-full"><i class="far fa-clock ml-1"></i> ${toPersianNumber(post.readingTime)} دقیقه</span>
            </div>
            <h1 class="text-2xl md:text-3xl font-extrabold text-rose-800">${post.title}</h1>
            <div class="flex gap-4 text-sm text-rose-500 mt-4 pb-4 border-b border-rose-100">
              <span><i class="far fa-calendar ml-1"></i> ${toPersianDate(post.publishedAt)}</span>
              <span><i class="far fa-user ml-1"></i> ${authorName}</span>
              <span><i class="far fa-eye ml-1"></i> ${toPersianNumber(post.viewCount)} بازدید</span>
            </div>
            <div id="postContent" class="post-content mt-6 text-rose-700 leading-loose">
              ${post.content}
            </div>
          </div>
        </div>
      </div>
      <div>
        <div class="bg-white/80 backdrop-blur rounded-2xl p-5 sticky top-4 shadow-lg border border-rose-100">
          <h3 class="font-extrabold text-rose-800 text-lg mb-4">مقالات دیگر</h3>
          <div class="space-y-3">
            ${relatedPosts.map(p => `
              <a href="/weblog/${p.slug}" class="related-post-link w-full text-right flex gap-3 items-center p-2 rounded-xl hover:bg-rose-50 transition no-underline">
                <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-pink-100 to-amber-100 flex items-center justify-center shrink-0 overflow-hidden">
                  ${p.images && p.images[0] ? 
                    `<img src="${p.images[0].url}" class="w-full h-full object-cover rounded-xl">` : 
                    `<i class="fas fa-tshirt text-pink-400 text-xl"></i>`
                  }
                </div>
                <div>
                  <h4 class="font-bold text-rose-800 text-sm line-clamp-2">${p.title}</h4>
                  <span class="text-xs text-rose-500">${toPersianDate(p.publishedAt)}</span>
                </div>
              </a>
            `).join("")}
          </div>
        </div>
      </div>
    </div>
  `;
  
  document.getElementById("singlePostContent").innerHTML = content;
  
  // نمایش صفحه تکی مقاله
  document.getElementById("singlePostView").classList.remove("hidden");
  document.getElementById("mainContent").classList.add("hidden");
  // حذف overflow: hidden از body - مهمترین قسمت
  document.body.style.overflow = "auto";
  
  // با تأخیر بیشتر TOC رو بساز
  setTimeout(function() {
      generateTableOfContents('#postContent', '#postTOC');
  }, 200);
  
  // به‌روزرسانی URL بدون رفرش
  window.history.pushState({ slug: post.slug }, post.title, `/weblog/${post.slug}`);
}

// ==================== بستن صفحه تکی ====================
function closeSinglePost() {
  document.getElementById("singlePostView").classList.add("hidden");
  document.getElementById("mainContent").classList.remove("hidden");
  document.body.style.overflow = "auto";
  
  // بازگشت به URL اصلی
  window.history.pushState({}, '', '/weblog');
}

// ==================== دسته‌بندی‌ها ====================
function setupCategories() {
  document.querySelectorAll(".category-chip").forEach(btn => {
    btn.addEventListener("click", async () => {
      document.querySelectorAll(".category-chip").forEach(b => {
        b.classList.remove("active", "bg-pink-500", "text-white");
        b.classList.add("bg-white/70", "text-rose-700");
      });
      btn.classList.add("active", "bg-pink-500", "text-white");
      btn.classList.remove("bg-white/70", "text-rose-700");
      
      currentCategory = btn.dataset.cat;
      const filterSpan = document.getElementById("filter-badge");
      if (filterSpan) {
        filterSpan.textContent = currentCategory === "all" ? "نمایش همه مقالات" : `نمایش: ${currentCategory}`;
      }
      await renderArticles();
    });
  });
}

function handleInitialSlug() {
  const initialSlug = '<%= typeof initialSlug !== "undefined" ? initialSlug : "" %>';
  if (initialSlug && initialSlug !== '') {
    showSinglePost(initialSlug);
  }
}

window.addEventListener('popstate', (event) => {
  const path = window.location.pathname;
  if (path === '/weblog' || path === '/weblog/') {
    closeSinglePost();
  } else if (path.startsWith('/weblog/')) {
    const slug = path.replace('/weblog/', '');
    showSinglePost(slug);
  }
});

// ==================== خبرنامه ====================
function setupNewsletter() {
  const form = document.getElementById("newsletterForm");
  const msg = document.getElementById("newsletterMsg");
  if (form) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const email = document.getElementById("newsletterEmail").value;
      if (!email || !email.includes("@")) {
        msg.textContent = "لطفاً ایمیل معتبر وارد کنید.";
        msg.classList.remove("hidden");
        return;
      }
      msg.textContent = "عضویت شما با موفقیت ثبت شد! به خانواده کیدل خوش آمدید.";
      msg.classList.remove("hidden");
      document.getElementById("newsletterEmail").value = "";
      setTimeout(() => msg.classList.add("hidden"), 3000);
    });
  }
}

// ==================== توابع پاپ‌آپ احراز هویت ====================
function showNotification(message, type = 'info') {
  const notification = document.createElement('div');
  notification.className = `fixed z-50 px-4 py-3 rounded-lg shadow-lg text-white text-sm sm:text-base ${
    type === 'success' ? 'bg-green-500' : type === 'error' ? 'bg-red-500' : 'bg-blue-500'
  } top-4 left-1/2 -translate-x-1/2 sm:left-auto sm:translate-x-0 sm:top-6 sm:right-6 w-[calc(100%-2rem)] max-w-xs sm:max-w-sm`;
  notification.textContent = message;
  document.body.appendChild(notification);
  notification.classList.add('transform', 'transition-all', 'duration-300', 'translate-y-2', 'opacity-0');
  setTimeout(() => notification.classList.remove('translate-y-2', 'opacity-0'), 10);
  setTimeout(() => {
    notification.classList.add('opacity-0', 'translate-y-2');
    setTimeout(() => notification.remove(), 300);
  }, 800);
}

function showNotificationInPopUp(message, type = 'info') {
  const authPopup = document.getElementById('auth-popup');
  if (!authPopup) return;
  const notification = document.createElement('div');
  notification.className = `fixed z-50 px-4 py-3 rounded-lg shadow-lg text-white text-sm sm:text-base ${
    type === 'success' ? 'bg-green-500' : type === 'error' ? 'bg-red-500' : 'bg-blue-500'
  }`;
  notification.textContent = message;
  notification.classList.add('transform', 'transition-all', 'duration-300', '-translate-y-[100px]', 'opacity-0');
  authPopup.appendChild(notification);
  setTimeout(() => notification.classList.remove('-translate-y-[100px]', 'opacity-0'), 10);
  setTimeout(() => {
    notification.classList.add('opacity-0', 'translate-y-2');
    setTimeout(() => notification.remove(), 300);
  }, 800);
}

function switchTab(activeTab) {
  const tabs = { login: document.getElementById("login-tab"), register: document.getElementById("register-tab"), forgot: document.getElementById("forgot-tab") };
  const contents = { login: document.getElementById("login-content"), register: document.getElementById("register-content"), forgot: document.getElementById("forgot-content") };
  if (!tabs[activeTab] || !contents[activeTab]) return;
  Object.values(tabs).forEach((tab) => { if(tab) { tab.classList.remove("border-pink-500", "text-pink-500"); tab.classList.add("text-gray-500"); } });
  Object.values(contents).forEach((content) => { if(content) content.classList.remove("active"); });
  tabs[activeTab].classList.add("border-pink-500", "text-pink-500");
  tabs[activeTab].classList.remove("text-gray-500");
  contents[activeTab].classList.add("active");
}

function setupOtpInputs(containerSelector) {
  const inputs = Array.from(document.querySelectorAll(`${containerSelector} .otp-input`));
  if (inputs.length === 0) return;
  inputs[inputs.length - 1].focus();
  inputs.forEach((input, index) => {
    input.addEventListener("input", function() { if (this.value.length === 1 && index > 0) inputs[index - 1].focus(); });
    input.addEventListener("keydown", function(e) { if (e.key === "Backspace" && this.value.length === 0 && index < inputs.length - 1) inputs[index + 1].focus(); });
  });
}

function getOtpValue(containerSelector) {
  const inputs = Array.from(document.querySelectorAll(`${containerSelector} .otp-input`));
  return inputs.map((input) => input.value).join("");
}

function startCountdown(elementId, seconds) {
  const timerElement = document.getElementById(elementId);
  if (!timerElement) return;
  const timerSpan = timerElement.querySelector("span");
  if (!timerSpan) return;
  let remaining = seconds;
  const interval = setInterval(() => {
    const minutes = Math.floor(remaining / 60);
    const secs = remaining % 60;
    timerSpan.textContent = `${minutes.toString().padStart(2, "0")}:${secs.toString().padStart(2, "0")}`;
    if (remaining <= 0) {
      clearInterval(interval);
      timerElement.innerHTML = '<a href="#" class="text-pink-500 resend-link">ارسال مجدد کد</a>';
      const resendLink = timerElement.querySelector('.resend-link');
      if (resendLink) {
        resendLink.addEventListener('click', function(e) {
          e.preventDefault();
          handleResendOtp(elementId);
        });
      }
    }
    remaining--;
  }, 1000);
}

function handleResendOtp(elementId) {
  const isRegister = elementId.includes('register');
  const phone = isRegister ? document.getElementById('register-phone')?.value : document.getElementById('forgot-phone')?.value;
  if (!phone) { showNotificationInPopUp('شماره موبایل یافت نشد', 'error'); return; }
  fetch("/api/mobile/sendOtp", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ mobile: phone }),
  })
  .then((res) => res.json())
  .then((data) => {
    if (data.success) { showNotificationInPopUp('کد تأیید جدید ارسال شد', 'success'); startCountdown(elementId, 120); }
    else { showNotificationInPopUp(data.message || 'خطا در ارسال کد تأیید', 'error'); }
  })
  .catch((err) => { console.error("Error:", err); showNotificationInPopUp('مشکلی در ارتباط با سرور به وجود آمده است', 'error'); });
}

// ==================== راه‌اندازی اولیه ====================
document.addEventListener("DOMContentLoaded", async () => {

  // نمایش اسکلت و بعد محتوا
  setTimeout(() => {
    const skeleton = document.getElementById("skeleton-grid");
    const articlesGrid = document.getElementById("articles-grid");
    if (skeleton) skeleton.classList.add("hidden");
    if (articlesGrid) articlesGrid.classList.remove("hidden");
    renderArticles();
  }, 700);
  
  setupCategories(); 

  await renderCategories();
  await renderArticles();
  await fetchStats();
  setupNewsletter();
  handleInitialSlug();
  
  // دکمه‌های بستن صفحه تکی
  const closeSinglePostBtn = document.getElementById("closeSinglePostBtn");
  if (closeSinglePostBtn) closeSinglePostBtn.addEventListener("click", closeSinglePost);
  
  const singlePostLogo = document.getElementById("singlePostLogo");
  if (singlePostLogo) singlePostLogo.addEventListener("click", (e) => { 
    e.preventDefault(); 
    closeSinglePost(); 
  });
  
  const logo = document.getElementById("logo");
  if (logo) logo.addEventListener("click", (e) => { e.preventDefault(); closeSinglePost(); window.scrollTo(0, 0); });
  
  // ==================== منوی موبایل ====================
  const menuBtn = document.getElementById('menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  if (menuBtn && mobileMenu) {
    menuBtn.onclick = function(e) {
      e.stopPropagation();
      if (mobileMenu.style.display === 'none' || mobileMenu.style.display === '') {
        mobileMenu.style.display = 'flex';
        document.body.classList.add('menu-open');
      } else {
        mobileMenu.style.display = 'none';
        document.body.classList.remove('menu-open');
      }
    };
  }
  
  document.querySelectorAll('.mobile-dropdown-trigger').forEach(trigger => {
    trigger.onclick = function(e) {
      e.stopPropagation();
      const menu = this.nextElementSibling;
      const icon = this.querySelector('i');
      if (menu.style.display === 'none' || menu.style.display === '') {
        menu.style.display = 'block';
        if(icon) icon.style.transform = 'rotate(180deg)';
      } else {
        menu.style.display = 'none';
        if(icon) icon.style.transform = 'rotate(0deg)';
      }
    };
  });
  
  document.querySelectorAll('.mobile-submenu-trigger').forEach(trigger => {
    trigger.onclick = function(e) {
      e.stopPropagation();
      const submenu = this.nextElementSibling;
      const icon = this.querySelector('i');
      if (submenu.style.display === 'none' || submenu.style.display === '') {
        submenu.style.display = 'block';
        if(icon) icon.style.transform = 'rotate(180deg)';
      } else {
        submenu.style.display = 'none';
        if(icon) icon.style.transform = 'rotate(0deg)';
      }
    };
  });
  
  // ==================== پاپ‌آپ احراز هویت ====================
  const authButton = document.getElementById('user-auth-button');
  const singlePostAuthBtn = document.getElementById('singlePostAuthBtn');
  const authPopup = document.getElementById('auth-popup');
  
  function openAuthPopup(e) {
    if(e) { e.preventDefault(); e.stopPropagation(); }
    if(authPopup) {
      authPopup.classList.remove('hidden');
      switchTab('login');
    }
  }
  
  if (authButton) authButton.addEventListener('click', openAuthPopup);
  if (singlePostAuthBtn) singlePostAuthBtn.addEventListener('click', openAuthPopup);
  
  if (authPopup) {
    authPopup.addEventListener('click', function(e) {
      if (e.target === authPopup) authPopup.classList.add('hidden');
    });
  }
  
  // Tab Switching Events
  const loginTab = document.getElementById("login-tab");
  const registerTab = document.getElementById("register-tab");
  const forgotTab = document.getElementById("forgot-tab");
  if (loginTab) loginTab.addEventListener("click", () => switchTab("login"));
  if (registerTab) registerTab.addEventListener("click", () => switchTab("register"));
  if (forgotTab) forgotTab.addEventListener("click", () => switchTab("forgot"));
  
  // Registration Process (همانند کد اصلی)
  const registerForm = document.getElementById("register-form");
  const registerStep1 = document.getElementById("register-step-1");
  const registerStep2 = document.getElementById("register-step-2");
  const registerPhoneDisplay = document.getElementById("register-phone-display");
  
  if (registerForm) {
    registerForm.addEventListener("submit", function(e) {
      e.preventDefault();
      const fullName = document.getElementById("register-name")?.value || "";
      const mobile = document.getElementById("register-phone")?.value.trim() || "";
      const email = document.getElementById("register-email")?.value.trim() || "";
      const password = document.getElementById("register-password")?.value || "";
      const confirmPassword = document.getElementById("register-confirm-password")?.value || "";
      const iranMobileRegex = /^09\d{9}$/;
      const emailRegex = /^\S+@\S+\.\S+$/;
      
      if (fullName.length < 3) { showNotificationInPopUp("نام کامل باید حداقل ۳ کاراکتر باشد", 'error'); return; }
      if (!iranMobileRegex.test(mobile)) { showNotificationInPopUp("شماره موبایل وارد شده معتبر نیست (مثال: 09123456789)", 'error'); return; }
      if (email && !emailRegex.test(email)) { showNotificationInPopUp("ایمیل وارد شده معتبر نیست", 'error'); return; }
      if (password.length < 8) { showNotificationInPopUp("رمز عبور باید حداقل ۸ کاراکتر باشد", 'error'); return; }
      if (password !== confirmPassword) { showNotificationInPopUp("رمز عبور و تکرار آن یکسان نیستند", 'error'); return; }
      
      const formDataRegister = new FormData(registerForm);
      const phone = mobile;
      if (registerPhoneDisplay) registerPhoneDisplay.textContent = phone;
      if (registerStep1) registerStep1.classList.remove("active");
      if (registerStep2) registerStep2.classList.add("active");
      startCountdown("register-resend-timer", 120);
      setupOtpInputs("#register-step-2");
      
      fetch("/api/mobile/sendOtp", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ mobile: phone }),
      })
      .then((res) => res.json())
      .then((data) => {
        if (data.success) {
          const registerVerificationForm = document.getElementById("register-verification-form");
          if (registerVerificationForm) {
            registerVerificationForm.addEventListener("submit", function(e) {
              e.preventDefault();
              const otpValue = getOtpValue("#register-step-2");
              const reversedOtpValue = otpValue.split("").reverse().join("");
              fetch("/api/mobile/verifyOtp", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ mobile: phone, otp: reversedOtpValue }),
              })
              .then((res) => res.json())
              .then((data) => {
                if (data.success) {
                  fetch("/api/authentication/signUp", {
                    method: "POST",
                    body: formDataRegister,
                  })
                  .then((res) => res.json())
                  .then((data) => {
                    if (data.success) {
                      showNotification(data.message, 'success');
                      if (authPopup) authPopup.classList.add("hidden");
                      setTimeout(() => location.reload(), 800);
                    } else { showNotificationInPopUp(data.message, 'error'); }
                  })
                  .catch((err) => { console.error("Error:", err); showNotificationInPopUp("مشکلی در ارتباط با سرور به وجود آمده است", 'error'); });
                } else { showNotificationInPopUp(data.message, 'error'); }
              })
              .catch((err) => { console.error("Error:", err); showNotificationInPopUp("مشکلی در ارتباط با سرور به وجود آمده است", 'error'); });
            }, { once: true });
          }
        } else { showNotificationInPopUp(data.message, 'error'); }
      })
      .catch((err) => { console.error("Error:", err); showNotificationInPopUp("مشکلی در ارتباط با سرور به وجود آمده است", 'error'); });
    });
  }
  
  const registerBackBtn = document.getElementById("register-back-btn");
  if (registerBackBtn) {
    registerBackBtn.addEventListener("click", function() {
      if (registerStep2) registerStep2.classList.remove("active");
      if (registerStep1) registerStep1.classList.add("active");
    });
  }
  
  // Forgot Password Process
  const forgotForm = document.getElementById("forgot-form");
  const forgotStep1 = document.getElementById("forgot-step-1");
  const forgotStep2 = document.getElementById("forgot-step-2");
  const forgotStep3 = document.getElementById("forgot-step-3");
  const forgotPhoneDisplay = document.getElementById("forgot-phone-display");
  
  if (forgotForm) {
    forgotForm.addEventListener("submit", function(e) {
      e.preventDefault();
      const phone = document.getElementById("forgot-phone")?.value || "";
      fetch("/api/authentication/forgotPassword", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ mobile: phone }),
      })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          if (forgotPhoneDisplay) forgotPhoneDisplay.textContent = phone;
          if (forgotStep1) forgotStep1.classList.remove("active");
          if (forgotStep2) forgotStep2.classList.add("active");
          startCountdown("forgot-resend-timer", 120);
          setupOtpInputs("#forgot-step-2");
          if (data.otp) console.log("OTP for testing:", data.otp);
        } else { showNotificationInPopUp(data.message, 'error'); }
      })
      .catch(err => { console.error("Error:", err); showNotificationInPopUp("مشکلی در ارتباط با سرور به وجود آمده است", 'error'); });
    });
  }
  
  const forgotBackBtn = document.getElementById("forgot-back-btn");
  if (forgotBackBtn) {
    forgotBackBtn.addEventListener("click", function() {
      if (forgotStep2) forgotStep2.classList.remove("active");
      if (forgotStep1) forgotStep1.classList.add("active");
    });
  }
  
  const forgotVerificationForm = document.getElementById("forgot-verification-form");
  if (forgotVerificationForm) {
    forgotVerificationForm.addEventListener("submit", function(e) {
      e.preventDefault();
      const otpValue = getOtpValue("#forgot-step-2");
      const reversedOtpValue = otpValue.split("").reverse().join("");
      fetch("/api/authentication/verifyPasswordResetOtp", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ mobile: forgotPhoneDisplay?.textContent || "", otp: reversedOtpValue }),
      })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          if (forgotStep2) forgotStep2.classList.remove("active");
          if (forgotStep3) forgotStep3.classList.add("active");
          const resetTokenInput = document.getElementById("reset-token");
          if (resetTokenInput && data.resetToken) resetTokenInput.value = data.resetToken;
        } else { showNotificationInPopUp(data.message, 'error'); }
      })
      .catch(err => { console.error("Error:", err); showNotificationInPopUp("مشکلی در ارتباط با سرور به وجود آمده است", 'error'); });
    });
  }
  
  // Login form submission
  const loginForm = document.getElementById("login-form");
  if (loginForm) {
    loginForm.addEventListener("submit", function(e) {
      e.preventDefault();
      const formDataLogin = new FormData(loginForm);
      fetch("/api/authentication/signIn", {
        method: "POST",
        body: formDataLogin,
      })
      .then((res) => res.json())
      .then((data) => {
        if (data.success) {
          showNotification(data.message, 'success');
          setTimeout(() => location.reload(), 800);
          if (authPopup) authPopup.classList.add("hidden");
        } else { showNotificationInPopUp(data.message, 'error'); }
      })
      .catch((err) => { console.error("Error:", err); showNotificationInPopUp("مشکلی در ارتباط با سرور به وجود آمده است", 'error'); });
    });
  }
  
  // New password form submission
  const newPasswordForm = document.getElementById("new-password-form");
  if (newPasswordForm) {
    newPasswordForm.addEventListener("submit", function(e) {
      e.preventDefault();
      const password = document.getElementById("new-password")?.value || "";
      const confirmPassword = document.getElementById("confirm-new-password")?.value || "";
      const resetToken = document.getElementById("reset-token")?.value || "";
      if (password !== confirmPassword) { showNotificationInPopUp("رمز عبور و تکرار آن یکسان نیستند", 'error'); return; }
      fetch(`/api/authentication/resetPassword/${resetToken}`, {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ password }),
      })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          showNotification("رمز عبور با موفقیت تغییر یافت! اکنون وارد شوید", 'success');
          if (authPopup) authPopup.classList.add("hidden");
          if (data.token) localStorage.setItem('token', data.token);
        } else { showNotificationInPopUp(data.message, 'error'); }
      })
      .catch(err => { console.error("Error:", err); showNotificationInPopUp("مشکلی در ارتباط با سرور به وجود آمده است", 'error'); });
    });
  }
  
  // Phone number input validation
  document.querySelectorAll('input[type="tel"]').forEach((input) => {
    input.addEventListener("input", function(e) { this.value = this.value.replace(/\D/g, ""); });
    input.addEventListener("blur", function() { if (!this.value.startsWith("0") && this.value.length > 0) this.value = "0" + this.value; });
  });
  
  setupOtpInputs("#register-step-2");
  setupOtpInputs("#forgot-step-2");
});
// تابع تولید جدول محتویات خودکار
// تابع تولید جدول محتویات خودکار
// تابع تولید جدول محتویات خودکار
function generateTableOfContents(contentSelector, tocContainerSelector) {
    const contentElement = document.querySelector(contentSelector);
    const tocContainer = document.querySelector(tocContainerSelector);
    
    if (!contentElement || !tocContainer) return;
    
    // پیدا کردن تمام هدینگ‌ها (h1, h2, h3)
    const headings = contentElement.querySelectorAll('h1, h2, h3');
    
    if (headings.length === 0) {
        tocContainer.style.display = 'none';
        return;
    }
    
    tocContainer.style.display = 'block';
    
    // ساخت HTML جدول محتویات
    let tocHTML = '<div class="table-of-contents">';
    tocHTML += '<h4>📑 فهرست مطالب</h4>';
    tocHTML += '<ul>';
    
    headings.forEach((heading, index) => {
        // ایجاد id یکتا برای هر هدینگ
        const id = `heading-${index}-${Date.now()}-${Math.random().toString(36).substr(2, 6)}`;
        heading.id = id;
        
        // اضافه کردن کلاس برای استایل‌بندی
        const level = heading.tagName.toLowerCase();
        heading.classList.add(`toc-heading-${level}`);
        
        // ساخت لینک در TOC
        const text = heading.textContent;
        const levelClass = `toc-level-${level}`;
        
        tocHTML += `
            <li class="${levelClass}">
                <a href="#${id}" class="toc-link" data-target="${id}">
                    ${level === 'h1' ? '📌 ' : level === 'h2' ? '• ' : '◦ '}
                    ${text}
                </a>
            </li>
        `;
    });
    
    tocHTML += '</ul></div>';
    
    tocContainer.innerHTML = tocHTML;
    
    // اضافه کردن event listener برای لینک‌ها با offset بیشتر
    const tocLinks = document.querySelectorAll('.toc-link');
    tocLinks.forEach(link => {
        link.addEventListener('click', function(e) {
            e.preventDefault();
            const targetId = this.dataset.target;
            const targetElement = document.getElementById(targetId);
            
            if (targetElement) {
                // اسکرول نرم به بخش مورد نظر با offset بیشتر برای navbar
                const navbarHeight = 80; // افزایش offset (navbar صفحه تکی مقاله)
                const elementPosition = targetElement.getBoundingClientRect().top;
                const offsetPosition = window.pageYOffset + elementPosition - navbarHeight;
                
                const scrollContainer = document.getElementById('singlePostView');

                scrollContainer.scrollTo({
                    top: targetElement.offsetTop - navbarHeight,
                    behavior: 'smooth'
                });
                
                // هایلایت کردن بخش
                targetElement.classList.add('section-highlight');
                setTimeout(() => {
                    targetElement.classList.remove('section-highlight');
                }, 1000);
                
                // آپدیت URL بدون رفرش
                history.pushState(null, null, `#${targetId}`);
            }
        });
    });
    
    // بررسی URL برای اسکرول خودکار بعد از ساخت TOC
    setTimeout(function() {
        if (window.location.hash) {
            const targetId = window.location.hash.substring(1);
            const targetElement = document.getElementById(targetId);
            
            if (targetElement) {
                const navbarHeight = 80;
                const elementPosition = targetElement.getBoundingClientRect().top;
                const offsetPosition = window.pageYOffset + elementPosition - navbarHeight;
                
                const scrollContainer = document.getElementById('singlePostView');

                scrollContainer.scrollTo({
                    top: targetElement.offsetTop - navbarHeight,
                    behavior: 'smooth'
                });
                
                targetElement.classList.add('section-highlight');
                setTimeout(() => {
                    targetElement.classList.remove('section-highlight');
                }, 1000);
            }
        }
    }, 300); // تأخیر بیشتر
}

// تابع برای اسکرول به بخش مورد نظر از URL (وقتی صفحه لود میشه)
function scrollToHeadingFromUrl() {
    if (window.location.hash) {
        const targetId = window.location.hash.substring(1);
        const targetElement = document.getElementById(targetId);
        
        if (targetElement) {
            setTimeout(() => {
                const offset = 80;
                const elementPosition = targetElement.getBoundingClientRect().top;
                const offsetPosition = elementPosition + window.pageYOffset - offset;
                
                const scrollContainer = document.getElementById('singlePostView');

                scrollContainer.scrollTo({
                    top: targetElement.offsetTop - 80,
                    behavior: 'smooth'
                });
         
                targetElement.classList.add('section-highlight');
                setTimeout(() => {
                    targetElement.classList.remove('section-highlight');
                }, 1000);
            }, 500);
        }
    }
}
