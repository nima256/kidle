    <div class="grid lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2">
        <div class="bg-white rounded-3xl p-5 shadow-xl border border-rose-100">
          <div class="image-placeholder rounded-2xl h-64 flex items-center justify-center">
            <i class="fas ${post.imageIcon || 'fa-tshirt'} text-7xl text-pink-400"></i>
          </div>
          <div class="mt-6">
            <div class="flex flex-wrap gap-2 mb-4">
              <span class="bg-pink-100 text-pink-600 text-xs font-bold px-3 py-1 rounded-full">${post.category}</span>
              <span class="bg-amber-50 text-rose-600 text-xs font-bold px-3 py-1 rounded-full"><i class="far fa-clock ml-1"></i> ${toPersianNumber(post.readTime)} دقیقه</span>
            </div>
            <h1 class="text-2xl md:text-3xl font-extrabold text-rose-800">${post.title}</h1>
            <div class="flex gap-4 text-sm text-rose-500 mt-4 pb-4 border-b border-rose-100">
              <span><i class="far fa-calendar ml-1"></i> ${post.date}</span>
              <span><i class="far fa-user ml-1"></i> ${post.author}</span>
            </div>
            <div class="post-content mt-6 text-rose-700 leading-loose">
              ${post.fullContent}
            </div>
          </div>
        </div>
      </div>
      <div>
        <div class="bg-white/80 backdrop-blur rounded-2xl p-5 sticky top-4 shadow-lg border border-rose-100">
          <h3 class="font-extrabold text-rose-800 text-lg mb-4">مقالات دیگر</h3>
          <div class="space-y-3">
            ${otherPosts.map(p => `
              <button class="related-post w-full text-right flex gap-3 items-center p-2 rounded-xl hover:bg-rose-50 transition" data-id="${p.id}">
                <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-pink-100 to-amber-100 flex items-center justify-center shrink-0">
                  <i class="fas ${p.imageIcon || 'fa-tshirt'} text-pink-400 text-xl"></i>
                </div>
                <div>
                  <h4 class="font-bold text-rose-800 text-sm line-clamp-2">${p.title}</h4>
