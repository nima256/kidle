let currentCategory = "all";

// ==================== توابع کمکی ====================
function toPersianNumber(num) {
  const digits = ['۰','۱','۲','۳','۴','۵','۶','۷','۸','۹'];
  return num.toString().replace(/\d/g, d => digits[parseInt(d)]);
}

// ==================== نمایش مقالات در صفحه اصلی ====================
function renderArticles() {
  const grid = document.getElementById("articles-grid");
  if (!grid) return;
  grid.innerHTML = "";
  
  const filtered = posts.filter(p => currentCategory === "all" || p.category === currentCategory);
  
  filtered.forEach(post => {
    const card = document.createElement("div");
    card.className = "article-card rounded-2xl p-3 shadow-sm fade-in";
    card.innerHTML = `
      <div class="image-placeholder rounded-xl h-44 flex items-center justify-center">
        <i class="fas ${post.imageIcon || 'fa-tshirt'} text-5xl text-pink-400"></i>
      </div>
      <div class="pt-4">
        <div class="flex flex-wrap gap-2 mb-2">
          <span class="bg-pink-100 text-pink-600 text-xs font-bold px-3 py-1 rounded-full">${post.category}</span>
          <span class="bg-amber-50 text-rose-600 text-xs font-bold px-3 py-1 rounded-full"><i class="far fa-clock ml-1"></i> ${toPersianNumber(post.readTime)} دقیقه</span>
        </div>
        <h3 class="font-extrabold text-rose-800 text-base leading-6 line-clamp-2 min-h-[48px]">${post.title}</h3>
        <div class="flex gap-3 text-xs text-rose-500 mt-2">
          <span><i class="far fa-calendar ml-1"></i> ${post.date}</span>
          <span><i class="far fa-user ml-1"></i> ${post.author}</span>
        </div>
        <p class="text-sm text-rose-600 mt-2 line-clamp-3">${post.description}</p>
        <button class="read-more-btn w-full mt-3 bg-pink-500 hover:bg-pink-600 text-white font-bold py-2.5 rounded-xl transition" data-id="${post.id}">
          ادامه مطلب <i class="fas fa-arrow-left mr-1"></i>
