    <script>
    // ==================== بخش نظرات محصول ====================
const productIdForComments = '<%= product?._id %>';

let allComments = [];
let currentPage = 1;
const commentsPerPage = 5;

// تبدیل اعداد به فارسی
function toPersianDigitsForComments(num) {
  if (num === undefined || num === null) return '۰';
  return num.toString().replace(/\d/g, d => '۰۱۲۳۴۵۶۷۸۹'[d]);
}

// تابع escape برای جلوگیری از XSS
function escapeHtmlForComments(text) {
  if (!text) return '';
  const div = document.createElement('div');
  div.textContent = text;
  return div.innerHTML;
}

// بارگذاری نظرات از سرور
async function loadComments(page = 1) {
  try {
    const response = await fetch(`/api/comments/product/${productIdForComments}?page=${page}&limit=${commentsPerPage}`);
    const data = await response.json();
    
    if (data.success) {
      if (page === 1) {
        allComments = data.comments;
      } else {
        allComments = [...allComments, ...data.comments];
      }
      
      currentPage = page;
      
      // به‌روزرسانی نمایش امتیاز و تعداد نظرات
      const commentsCountDisplay = document.getElementById('comments-count-display');
      const averageRatingDisplay = document.getElementById('average-rating-display');
      
      if (commentsCountDisplay) {
        commentsCountDisplay.textContent = toPersianDigitsForComments(data.totalComments);
      }
      
      if (averageRatingDisplay) {
        averageRatingDisplay.textContent = data.averageRating ? data.averageRating.toFixed(1) : '۰';
      }
      
      // نمایش نظرات
      renderComments(allComments);
      
      // مدیریت دکمه بارگذاری بیشتر
      const loadMoreContainer = document.getElementById('load-more-container');
      if (data.hasMore) {
        loadMoreContainer.classList.remove('hidden');
      } else {
        loadMoreContainer.classList.add('hidden');
      }
    }
  } catch (error) {
    console.error('خطا در بارگذاری نظرات:', error);
  }
}

// رندر کردن نظرات
function renderComments(comments) {
  const commentsList = document.getElementById('comments-list');
  const noCommentsMessage = document.getElementById('no-comments-message');
  
  if (!commentsList) return;
  
  if (comments.length === 0) {
    if (noCommentsMessage) noCommentsMessage.style.display = 'block';
    commentsList.innerHTML = '';
    if (noCommentsMessage) commentsList.appendChild(noCommentsMessage);
    return;
  }
  
  if (noCommentsMessage) noCommentsMessage.style.display = 'none';
  
  let commentsHtml = '';
  
  comments.forEach(comment => {
    // ساخت ستاره‌های امتیاز
    let starsHtml = '';
    const rating = comment.rating || 0;
    for (let i = 1; i <= 5; i++) {
      if (i <= rating) {
        starsHtml += '<i class="fas fa-star text-yellow-400 text-sm"></i>';
      } else {
        starsHtml += '<i class="far fa-star text-gray-300 text-sm"></i>';
      }
    }
    
    // تاریخ
    const commentDate = new Date(comment.createdAt);
    const persianDate = `${toPersianDigitsForComments(commentDate.getFullYear())}/${toPersianDigitsForComments(commentDate.getMonth() + 1)}/${toPersianDigitsForComments(commentDate.getDate())}`;
    
    commentsHtml += `
      <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100 hover:shadow-md transition">
        <div class="flex justify-between items-start mb-2">
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 bg-gradient-to-r from-pink-400 to-rose-400 rounded-full flex items-center justify-center text-white text-sm font-bold">
              ${comment.userName ? comment.userName.charAt(0).toUpperCase() : 'ک'}
            </div>
            <div>
              <span class="font-semibold text-gray-800">${escapeHtmlForComments(comment.userName || 'کاربر مهمان')}</span>
              <div class="flex items-center gap-1 mt-0.5">
                ${starsHtml}
              </div>
            </div>
          </div>
          <span class="text-xs text-gray-400">${persianDate}</span>
        </div>
        <p class="text-gray-600 text-sm leading-relaxed pr-10 mr-1">${escapeHtmlForComments(comment.text)}</p>
      </div>
    `;
  });
  
  commentsList.innerHTML = commentsHtml;
}

// ثبت نظر جدید
async function submitComment(event) {
  event.preventDefault();
  
  const ratingInput = document.querySelector('input[name="rating"]:checked');
  const rating = ratingInput ? parseInt(ratingInput.value) : 0;
  const userName = document.getElementById('comment-name')?.value.trim();
  const commentText = document.getElementById('comment-text')?.value.trim();
  
  // اعتبارسنجی
  if (rating === 0) {
    showNotificationForComments('لطفاً به محصول امتیاز دهید', 'error');
    return;
  }
  
  if (!userName) {
    showNotificationForComments('لطفاً نام خود را وارد کنید', 'error');
    return;
  }
  
  if (!commentText) {
    showNotificationForComments('لطفاً متن نظر را وارد کنید', 'error');
    return;
  }
  
  if (commentText.length < 5) {
    showNotificationForComments('متن نظر باید حداقل ۵ کاراکتر باشد', 'error');
    return;
  }
  
  try {
    const response = await fetch('/api/comments/add', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        productId: productIdForComments,
        userName: userName,
        rating: rating,
        text: commentText
      })
    });
    
    const data = await response.json();
    
    if (data.success) {
      showNotificationForComments('نظر شما با موفقیت ثبت شد', 'success');
      
      document.getElementById('comment-form').reset();
      document.querySelectorAll('.rating-stars label').forEach(label => {
        label.classList.remove('text-yellow-400');
        label.classList.add('text-gray-300');
      });
      
      await loadComments(1);
    } else {
      showNotificationForComments(data.message || 'خطا در ثبت نظر', 'error');
    }
  } catch (error) {
    console.error('خطا در ثبت نظر:', error);
    showNotificationForComments('مشکلی در ارتباط با سرور به وجود آمده است', 'error');
  }
}

// نوتیفیکیشن
function showNotificationForComments(message, type = 'info') {
  const notification = document.createElement('div');
  notification.className = `fixed z-50 px-4 py-3 rounded-lg shadow-lg text-white text-sm sm:text-base ${
    type === 'success' ? 'bg-green-500' :
    type === 'error' ? 'bg-red-500' :
    'bg-blue-500'
  } top-4 left-1/2 -translate-x-1/2 sm:left-auto sm:translate-x-0 sm:top-6 sm:right-6 w-[calc(100%-2rem)] max-w-xs sm:max-w-sm`;
  
  notification.textContent = message;
  document.body.appendChild(notification);
  
  notification.classList.add('transform', 'transition-all', 'duration-300', 'translate-y-2', 'opacity-0');
  setTimeout(() => {
    notification.classList.remove('translate-y-2', 'opacity-0');
  }, 10);
  
  setTimeout(() => {
    notification.classList.add('opacity-0', 'translate-y-2');
    setTimeout(() => notification.remove(), 300);
  }, 2000);
}

// راه‌اندازی ستاره‌های ریتینگ
function setupRatingStars() {
  const starsContainer = document.querySelector('.rating-stars');
  if (!starsContainer) return;
  
  const stars = starsContainer.querySelectorAll('label');
  
  stars.forEach((star, index) => {
    star.addEventListener('click', () => {
      stars.forEach(s => {
        s.classList.remove('text-yellow-400');
        s.classList.add('text-gray-300');
      });
      for (let i = stars.length - 1; i >= index; i--) {
        stars[i].classList.remove('text-gray-300');
        stars[i].classList.add('text-yellow-400');
      }
    });
  });
}

// مقداردهی اولیه
function initCommentsSection() {
  if (!productIdForComments || productIdForComments === 'undefined') {
    console.warn('productId برای بخش نظرات موجود نیست');
    return;
  }
  
  setupRatingStars();
  loadComments(1);
  
  const commentForm = document.getElementById('comment-form');
  if (commentForm) {
    commentForm.addEventListener('submit', submitComment);
  }
  
  const loadMoreBtn = document.getElementById('load-more-comments');
  if (loadMoreBtn) {
    loadMoreBtn.addEventListener('click', () => {
      loadComments(currentPage + 1);
    });
  }
}

// اجرا بعد از بارگذاری صفحه
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initCommentsSection);
} else {
  initCommentsSection();
}
