      /* جلوگیری از اسکرول وقتی منو بازه */
body.menu-open {
  overflow: hidden;
  position: fixed;
  width: 100%;
  height: 100%;
} 
      /* اضافه کنید به استایل‌ها */
.gallery-popup-container {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.95);
  z-index: 9999;
  display: none;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(5px);
}

.gallery-popup-container.active {
  display: flex;
}

.gallery-popup-content {
  position: relative;
  width: 90%;
  max-width: 1200px;
  height: 90vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gallery-popup-image {
  max-width: 90%;
  max-height: 85vh;
  object-fit: contain;
  border-radius: 12px;
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
}

.gallery-popup-close {
  position: absolute;
  top: 20px;
  right: 20px;
  width: 40px;
  height: 40px;
  background: rgba(0, 0, 0, 0.7);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 24px;
  cursor: pointer;
  transition: all 0.3s ease;
  z-index: 10;
}

.gallery-popup-close:hover {
  background: rgba(0, 0, 0, 0.9);
  transform: scale(1.1);
}

.gallery-popup-prev,
.gallery-popup-next {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 50px;
  height: 50px;
  background: rgba(0, 0, 0, 0.7);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 28px;
  cursor: pointer;
  transition: all 0.3s ease;
  z-index: 10;
}

.gallery-popup-prev {
  left: 20px;
}
.pb-4 {
    padding-bottom: 2rem;
}
.gallery-popup-next {
  right: 20px;
}

.gallery-popup-prev:hover,
.gallery-popup-next:hover {
  background: rgba(0, 0, 0, 0.9);
  transform: translateY(-50%) scale(1.1);
}

.gallery-popup-counter {
  position: absolute;
  bottom: 20px;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(0, 0, 0, 0.7);
  padding: 8px 16px;
  border-radius: 30px;
  color: white;
  font-size: 14px;
  z-index: 10;
}

.gallery-popup-thumbnails {
  position: absolute;
  bottom: 80px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 10px;
  padding: 10px;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 12px;
  overflow-x: auto;
  max-width: 80%;
  z-index: 10;
}

.gallery-popup-thumbnails img {
  width: 60px;
  height: 60px;
  object-fit: cover;
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.3s ease;
  border: 2px solid transparent;
}

.gallery-popup-thumbnails img:hover {
  transform: scale(1.05);
  border-color: #ec4899;
}

.gallery-popup-thumbnails img.active {
  border-color: #ec4899;
  box-shadow: 0 0 0 2px rgba(236, 72, 153, 0.5);
}

@media (max-width: 768px) {
  .gallery-popup-prev,
  .gallery-popup-next {
    width: 40px;
    height: 40px;
    font-size: 20px;
  }
  
  .gallery-popup-thumbnails {
    bottom: 70px;
  }
  
  .gallery-popup-thumbnails img {
    width: 45px;
    height: 45px;
  }
}
/* استایل‌های ریسپانسیو برای موبایل */
@media (max-width: 768px) {
  /* کاهش فاصله‌ها و padding در کارت‌ها */
  .section-card {
    padding: 16px !important;
    margin-bottom: 12px !important;
  }
  
  /* کوچک‌تر کردن عنوان محصول */
  .section-card h1 {
    font-size: 20px !important;
    margin-bottom: 8px !important;
  }
  
  /* کوچک‌تر کردن قیمت */
  .section-card .text-3xl {
    font-size: 22px !important;
  }
  
  /* رنگ‌ها - تبدیل به 3 ستون با دایره‌های کوچک‌تر */
  .grid-cols-4 {
    grid-template-columns: repeat(3, 1fr) !important;
    gap: 12px !important;
  }
  
  .color-swatch {
    width: 45px !important;
    height: 45px !important;
  }
  
  .color-swatch.selected::after {
    font-size: 10px !important;
  }
  
  /* حجم‌ها - تبدیل به 2 ستون */
  .grid-cols-3 {
    grid-template-columns: repeat(2, 1fr) !important;
    gap: 10px !important;
  }
  
  .volume-option {
    padding: 8px 12px !important;
  }
  
  .volume-option .text-lg {
    font-size: 14px !important;
  }
  
  .volume-option .text-xs {
    font-size: 10px !important;
  }
  
  /* ویژگی‌ها - تبدیل به 2 ستون در موبایل */
  .grid-cols-1.sm\:grid-cols-2 {
    grid-template-columns: repeat(2, 1fr) !important;
    gap: 8px !important;
  }
  
  .feature-card {
    padding: 10px !important;
  }
  
  .feature-card .w-12 {
    width: 32px !important;
    height: 32px !important;
  }
  
  .feature-card h4 {
    font-size: 12px !important;
  }
  
  .feature-card p {
    font-size: 10px !important;
  }
  /* نسخه قوی‌تر برای رفع مشکل */
.section-card .text-gray-700 {
  word-break: break-word !important;
  overflow-wrap: break-word !important;
  word-wrap: break-word !important;
  white-space: normal !important;
  hyphens: auto !important;
}
  /* دکمه افزودن به سبد خرید */
  #add-to-cart {
    padding: 12px 16px !important;
    font-size: 14px !important;
  }
  
  /* عنوان‌های بخش‌ها */
  .section-card h3 {
    font-size: 16px !important;
    margin-bottom: 12px !important; 
  }
  
  /* متن رنگ و حجم انتخابی */
  .text-sm.text-gray-600 {
    font-size: 12px !important;
    margin-top: 8px !important;
  }
  
  /* توضیحات محصول */
  .text-gray-700 {
    font-size: 13px !important;
    line-height: 1.5 !important;
  }
  
  /* کاهش فضای خالی بین بخش‌ها */
  .space-y-8 {
    gap: 12px !important;
    display: flex !important;
    flex-direction: column !important;
  }
  
  /* فاصله بین المنت‌ها در main */
  main .grid {
    gap: 20px !important;
  }
  
  /* کوچک‌تر کردن thumbnails */
  .thumbnail {
    padding: 8px !important;
  }
  
  .thumbnail img {
    width: 40px !important;
    height: 40px !important;
  }
  
  /* تصویر اصلی */
  .main-image {
    height: 250px !important;
  }
  
  .section-card.p-8 {
    padding: 15px !important;
  }
}

/* فشرده‌سازی کل صفحه در موبایل */
@media (max-width: 768px) {
  main {
    padding-top: 20px !important;
    padding-bottom: 20px !important;
  }
  
  main .px-6 {
    padding-left: 12px !important;
    padding-right: 12px !important;
  }
  
  /* حذف padding اضافی از header */
  header .px-6 {
    padding-left: 12px !important;
    padding-right: 12px !important;
  }
  
  header .py-5 {
    padding-top: 12px !important;
    padding-bottom: 12px !important;
  }
  
  /* کوچک‌تر کردن دکمه بازگشت */
  header .w-6 {
    width: 20px !important;
    height: 20px !important;
  }
  
  header .text-lg {
    font-size: 14px !important;
  }
  
  /* حذف فضای اضافی nav */
  nav {
    padding: 8px 12px !important;
  }
  
  nav img {
    height: 36px !important;
  }
  
  /* کاهش فضای خالی در footer */
  footer .py-12 {
    padding-top: 24px !important;
    padding-bottom: 24px !important;
  }
  
  footer .gap-8 {
    gap: 20px !important;
  }
  
  /* حذف فاصله اضافی اول صفحه */
  br {
    display: none !important;
  }
  
  /* فاصله بین ستون اصلی محصولات */
  .grid-cols-1.lg\:grid-cols-2 {
    gap: 16px !important;
  }
}
    </style>
