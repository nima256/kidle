// گالری تصاویر
// گالری تصاویر پیشرفته


// گالری تصاویر پیشرفته با فول اسکرین
let currentImageIndex = 0;
let galleryImages = <%- JSON.stringify(product.images.map(img => img.url)) %>;

function openGallery(index) {
  currentImageIndex = index;
  
  // به‌روزرسانی تصویر اصلی
  const mainImage = document.getElementById('main-image');
  if (mainImage) {
    mainImage.src = galleryImages[currentImageIndex];
  }
  
  // آپدیت کردن کلاس active تامبنیل‌ها
  const thumbnails = document.querySelectorAll('.thumbnail');
  thumbnails.forEach((thumb, i) => {
    if (i === currentImageIndex) {
      thumb.classList.add('active');
    } else {
      thumb.classList.remove('active');
    }
  });
  
  // باز کردن پاپ‌آپ گالری
  openGalleryPopup(currentImageIndex);
}

function openGalleryPopup(index) {
  const popup = document.getElementById('gallery-popup');
  if (!popup) return;
  
  currentImageIndex = index;
  
  // ساخت thumbnails داخل پاپ‌آپ
  const thumbnailsContainer = document.getElementById('gallery-thumbnails');
  if (thumbnailsContainer && galleryImages.length > 0) {
    thumbnailsContainer.innerHTML = '';
    galleryImages.forEach((img, i) => {
      const thumbImg = document.createElement('img');
      thumbImg.src = img;
      thumbImg.alt = `تصویر ${i + 1}`;
      thumbImg.onclick = (function(idx) {
        return function() { 
          currentImageIndex = idx;
          updateGalleryImage();
        };
      })(i);
      if (i === currentImageIndex) {
        thumbImg.classList.add('active');
      }
      thumbnailsContainer.appendChild(thumbImg);
    });
  }
  
  // تنظیم تصویر اصلی پاپ‌آپ
  const galleryImage = document.getElementById('gallery-image');
  const galleryCounter = document.getElementById('gallery-counter');
  
  if (galleryImage) {
    galleryImage.src = galleryImages[currentImageIndex];
  }
  if (galleryCounter) {
    galleryCounter.textContent = `${toPersianDigits(currentImageIndex + 1)} از ${toPersianDigits(galleryImages.length)}`;
  }
  
  // نمایش پاپ‌آپ با انیمیشن
  popup.style.display = 'flex';
  popup.classList.add('active');
  document.body.style.overflow = 'hidden';
  
  // اضافه کردن event listener برای کلیدهای کیبورد
  document.addEventListener('keydown', handleGalleryKeydown);
}

function closeGallery() {
  const popup = document.getElementById('gallery-popup');
  if (popup) {
    popup.classList.remove('active');
    popup.style.display = 'none';
  }
  document.body.style.overflow = 'auto';
  document.removeEventListener('keydown', handleGalleryKeydown);
}

function nextImage() {
  if (!galleryImages.length) return;
  currentImageIndex = (currentImageIndex + 1) % galleryImages.length;
  updateGalleryImage();
}

function prevImage() {
  if (!galleryImages.length) return;
  currentImageIndex = (currentImageIndex - 1 + galleryImages.length) % galleryImages.length;
  updateGalleryImage();
}

function updateGalleryImage() {
  const galleryImage = document.getElementById('gallery-image');
  const galleryCounter = document.getElementById('gallery-counter');
  const thumbnails = document.querySelectorAll('#gallery-thumbnails img');
  
  if (galleryImage) {
    galleryImage.src = galleryImages[currentImageIndex];
  }
  if (galleryCounter) {
    galleryCounter.textContent = `${toPersianDigits(currentImageIndex + 1)} از ${toPersianDigits(galleryImages.length)}`;
  }
  
  // آپدیت active thumbnail
  thumbnails.forEach((thumb, i) => {
    if (i === currentImageIndex) {
      thumb.classList.add('active');
    } else {
      thumb.classList.remove('active');
    }
  });
}

function handleGalleryKeydown(e) {
  if (e.key === 'Escape') {
    closeGallery();
  } else if (e.key === 'ArrowRight') {
    nextImage();
  } else if (e.key === 'ArrowLeft') {
    prevImage();
  }
}

// تابع تبدیل اعداد به فارسی
function toPersianDigits(str) {
  if (str === undefined || str === null) return '۰';
  const num = str.toString();
  return num.replace(/\d/g, d => '۰۱۲۳۴۵۶۷۸۹'[d]);
}
