<%
  var p = product, isNew = !p._id;
  locals.richEditor = true;
  locals.headerActions = (p._id && p.isPublished ? '<a class="btn btn-ghost btn-sm" target="_blank" href="/productDetails/' + p.slug + '">' + icon('eye','icon-sm') + ' مشاهده</a>' : '') + '<button form="pf" class="btn btn-primary btn-sm"><span class="spinner"></span><span class="btn-label-idle">ذخیره</span></button>';
  var sel = (p.category || []).map(String);
%>
<%- include('_top') %>
<form id="pf" data-api="<%= isNew ? '/admin/api/products' : '/admin/api/products/' + p._id %>" data-method="<%= isNew ? 'POST' : 'PUT' %>" <%= isNew ? 'data-follow' : '' %> novalidate class="grid gap-4 xl:grid-cols-[1fr_20rem]">
  <% if (!isNew) { %><input type="hidden" name="expectedStock" value="<%= p.countInStock %>"><% } %>
  <div class="space-y-4">
    <section class="card card-pad space-y-3">
      <div class="field"><label class="label" for="name">نام محصول <span class="req">*</span></label><input class="input" id="name" name="name" value="<%= p.name || '' %>" maxlength="100" required><p class="field-error" data-err="name" hidden></p></div>
      <div class="grid gap-3 sm:grid-cols-2">
        <div class="field"><label class="label" for="en">نام انگلیسی</label><input class="input ltr" id="en" name="englishName" value="<%= p.englishName || '' %>"></div>
        <div class="field"><label class="label" for="brand">برند <span class="req">*</span></label><select class="select" id="brand" name="brand"><option value="">انتخاب برند</option><% brands.forEach(function (b) { %><option value="<%= b._id %>" <%= String(p.brand) === String(b._id) ? 'selected' : '' %>><%= b.name %></option><% }) %></select><p class="field-error" data-err="brand" hidden></p></div>
      </div>
      <div class="field"><label class="label" for="lil">توضیح کوتاه</label><textarea class="textarea !min-h-16" id="lil" name="lilDescription" maxlength="400" rows="2" placeholder="یک یا دو جمله؛ زیر عنوان و در نتایج جستجو نمایش داده می‌شود"><%= p.lilDescription || '' %></textarea></div>
      <div class="field"><span class="label">توضیحات کامل</span><div data-rich="description" class="rounded-md bg-white"><template><%- p.description || '' %></template></div></div>
    </section>

    <section class="card card-pad">
      <h2 class="mb-3 text-sm font-bold">تصاویر</h2>
      <div data-uploader data-folder="product">
        <div class="flex flex-wrap gap-2" data-images="images">
          <% (p.images || []).forEach(function (im) { %>
          <div class="relative w-28 shrink-0 overflow-hidden rounded-md border border-ink-200 bg-white" data-image data-url="<%= im.url %>" data-filename="<%= im.filename %>">
            <img src="<%= im.url %>" alt="" class="aspect-[4/5] w-full object-cover">
            <input class="w-full border-t border-ink-100 px-1.5 py-1 text-2xs outline-none" placeholder="متن جایگزین (alt)" value="<%= im.alt || im.caption || '' %>">
            <div class="absolute top-1 start-1 flex gap-1"><button type="button" class="rounded bg-white/90 px-1.5 text-2xs font-bold shadow-xs" data-img-first title="تصویر اصلی">اصلی</button><button type="button" class="rounded bg-white/90 px-1 text-danger-600 shadow-xs" data-img-remove aria-label="حذف تصویر"><%- icon('x','icon-sm') %></button></div>
          </div>
          <% }) %>
        </div>
        <label class="mt-3 flex cursor-pointer items-center justify-center gap-2 rounded-lg border-2 border-dashed border-ink-300 p-4 text-sm text-ink-600 hover:border-brand-400 hover:text-brand-700">
          <%- icon('upload','icon-sm') %> افزودن تصویر (JPG/PNG/WebP، حداکثر ۸ مگابایت) <span data-upload-status class="text-xs"></span>
          <input type="file" accept="image/jpeg,image/png,image/webp" multiple class="sr-only">
        </label>
        <p class="hint mt-1">اولین تصویر، تصویر اصلی است. نسبت پیشنهادی ۴ به ۵ (مثلاً ۱۲۰۰×۱۵۰۰).</p>
      </div>
    </section>

    <section class="card card-pad">
      <div class="mb-2 flex items-center justify-between"><h2 class="text-sm font-bold">سایزها</h2><button type="button" class="btn btn-soft btn-sm" data-add-row="sizes"><%- icon('plus','icon-sm') %> سایز</button></div>
      <p class="hint mb-2">مثلاً سایز «۴» با توضیح «۳ تا ۴ سال» — توضیح زیر دکمه سایز به مشتری نمایش داده می‌شود.</p>
      <div class="space-y-2" data-repeat="sizes">
        <% (p.sizes || []).forEach(function (s) { %><div class="flex gap-2" data-row><input class="input !min-h-10" data-field="size" value="<%= s.size %>" placeholder="سایز" aria-label="سایز"><input class="input !min-h-10" data-field="usage" value="<%= s.usage || '' %>" placeholder="مناسب برای (سن/قد)" aria-label="مناسب برای"><button type="button" class="btn-icon shrink-0 text-danger-600" data-remove-row-btn aria-label="حذف"><%- icon('trash','icon-sm') %></button></div><% }) %>
      </div>
      <template data-template="sizes"><div class="flex gap-2" data-row><input class="input !min-h-10" data-field="size" placeholder="سایز" aria-label="سایز"><input class="input !min-h-10" data-field="usage" placeholder="مناسب برای (سن/قد)" aria-label="مناسب برای"><button type="button" class="btn-icon shrink-0 text-danger-600" data-remove-row-btn aria-label="حذف"><%- icon('trash','icon-sm') %></button></div></template>
    </section>

    <section class="card card-pad">
      <div class="mb-2 flex items-center justify-between"><h2 class="text-sm font-bold">رنگ‌ها</h2><button type="button" class="btn btn-soft btn-sm" data-add-row="colors"><%- icon('plus','icon-sm') %> رنگ</button></div>
      <div class="space-y-2" data-repeat="colors">
        <% (p.colors || []).forEach(function (c) { %><div class="flex gap-2" data-row><input type="color" class="h-10 w-12 shrink-0 cursor-pointer rounded-md border border-ink-300" data-field="rgb" value="<%= c.rgb %>" aria-label="رنگ"><input class="input !min-h-10" data-field="name" value="<%= c.name %>" placeholder="نام رنگ" aria-label="نام رنگ"><button type="button" class="btn-icon shrink-0 text-danger-600" data-remove-row-btn aria-label="حذف"><%- icon('trash','icon-sm') %></button></div><% }) %>
      </div>
      <template data-template="colors"><div class="flex gap-2" data-row><input type="color" class="h-10 w-12 shrink-0 cursor-pointer rounded-md border border-ink-300" data-field="rgb" value="#f7a8c4" aria-label="رنگ"><input class="input !min-h-10" data-field="name" placeholder="نام رنگ" aria-label="نام رنگ"><button type="button" class="btn-icon shrink-0 text-danger-600" data-remove-row-btn aria-label="حذف"><%- icon('trash','icon-sm') %></button></div></template>
    </section>

    <section class="card card-pad">
      <div class="mb-2 flex items-center justify-between"><h2 class="text-sm font-bold">مشخصات</h2><button type="button" class="btn btn-soft btn-sm" data-add-row="specifications"><%- icon('plus','icon-sm') %> مشخصه</button></div>
      <div class="space-y-2" data-repeat="specifications">
        <% (p.specifications || []).forEach(function (s) { %><div class="flex gap-2" data-row><input class="input !min-h-10" data-field="key" value="<%= s.key %>" placeholder="عنوان (مثلاً جنس)" aria-label="عنوان"><input class="input !min-h-10" data-field="value" value="<%= s.value %>" placeholder="مقدار" aria-label="مقدار"><button type="button" class="btn-icon shrink-0 text-danger-600" data-remove-row-btn aria-label="حذف"><%- icon('trash','icon-sm') %></button></div><% }) %>
      </div>
      <template data-template="specifications"><div class="flex gap-2" data-row><input class="input !min-h-10" data-field="key" placeholder="عنوان (مثلاً جنس)" aria-label="عنوان"><input class="input !min-h-10" data-field="value" placeholder="مقدار" aria-label="مقدار"><button type="button" class="btn-icon shrink-0 text-danger-600" data-remove-row-btn aria-label="حذف"><%- icon('trash','icon-sm') %></button></div></template>
    </section>
  </div>

  <div class="space-y-4">
    <section class="card card-pad space-y-2">
      <h2 class="text-sm font-bold">انتشار</h2>
      <label class="f-check"><input class="check" type="checkbox" name="isPublished" <%= p.isPublished ? 'checked' : '' %>> نمایش در فروشگاه</label>
      <label class="f-check"><input class="check" type="checkbox" name="isNewProduct" <%= p.isNewProduct ? 'checked' : '' %>> برچسب «جدید»</label>
      <label class="f-check"><input class="check" type="checkbox" name="isFeatured" <%= p.isFeatured ? 'checked' : '' %>> پیشنهاد کیدل (صفحه اصلی)</label>
      <label class="f-check"><input class="check" type="checkbox" name="isPopular" <%= p.isPopular ? 'checked' : '' %>> پرفروش</label>
    </section>
    <section class="card card-pad space-y-3">
      <h2 class="text-sm font-bold">قیمت و موجودی</h2>
      <div class="field"><label class="label" for="price">قیمت (تومان) <span class="req">*</span></label><input class="input ltr" id="price" name="price" inputmode="numeric" value="<%= p.price || '' %>"><p class="field-error" data-err="price" hidden></p></div>
      <div class="field"><label class="label" for="offer">قیمت با تخفیف (تومان)</label><input class="input ltr" id="offer" name="offerPrice" inputmode="numeric" value="<%= p.offerPrice || '' %>" placeholder="خالی = بدون تخفیف"><p class="field-error" data-err="offerPrice" hidden></p></div>
      <div class="field"><label class="label" for="stock">موجودی انبار <span class="req">*</span></label><input class="input ltr" id="stock" name="countInStock" inputmode="numeric" value="<%= p.countInStock != null ? p.countInStock : 0 %>"><p class="field-error" data-err="countInStock" hidden></p><p class="hint">موجودی رزروشده برای پرداخت‌های در جریان از این عدد کم شده است.</p></div>
    </section>
    <section class="card card-pad">
      <h2 class="mb-2 text-sm font-bold">دسته‌بندی <span class="req text-brand-600">*</span></h2>
      <div class="max-h-60 overflow-y-auto">
        <% categories.forEach(function (c) { %><label class="f-check" style="padding-inline-start: <%= 0.25 + c.depth * 1.1 %>rem"><input class="check" type="checkbox" name="category[]" value="<%= c._id %>" <%= sel.indexOf(String(c._id)) !== -1 ? 'checked' : '' %>> <%= c.name %></label><% }) %>
      </div>
      <p class="field-error" data-err="category" hidden></p>
    </section>
    <section class="card card-pad space-y-3">
      <h2 class="text-sm font-bold">سایر</h2>
      <div class="field"><label class="label" for="tags">برچسب‌ها</label><input class="input" id="tags" name="tags" value="<%= (p.tags || []).join('، ') %>" placeholder="با ویرگول جدا کنید"><p class="hint">در جستجوی سایت هم استفاده می‌شود.</p></div>
      <div class="field"><label class="label" for="gu">گارانتی/ضمانت</label><input class="input" id="gu" name="guarantee" value="<%= p.guarantee || '' %>"></div>
      <div class="field"><label class="label" for="w">وزن (گرم)</label><input class="input ltr" id="w" name="weight" inputmode="numeric" value="<%= typeof p.weight === 'number' ? p.weight : '' %>"></div>
      <div class="field"><label class="label" for="pg">شناسه گروه محصول (ترب)</label><input class="input ltr" id="pg" name="product_group_id" value="<%= p.product_group_id || '' %>"></div>
    </section>
    <button class="btn btn-primary btn-lg btn-block"><span class="spinner"></span><span class="btn-label-idle">ذخیره محصول</span></button>
  </div>
</form>
<%- include('_bottom') %>
