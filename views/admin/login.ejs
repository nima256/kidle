<!doctype html>
<html lang="fa" dir="rtl" class="theme-light">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex, nofollow">
<title>ورود به پنل مدیریت | کیدل</title>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="<%= asset('/css/app.css') %>">
</head>
<body class="flex min-h-dvh items-center justify-center bg-linen-100 p-4">
  <main class="card w-full max-w-sm p-7 shadow-md">
    <div class="mb-5 text-center">
      <svg viewBox="0 0 40 48" class="mx-auto h-12 w-auto" aria-hidden="true"><path d="M0 20a20 20 0 0 1 40 0v24a4 4 0 0 1-4 4H4a4 4 0 0 1-4-4Z" fill="#b02a58"/><path d="M12 30q8 8 16 0" fill="none" stroke="#faf6f1" stroke-width="3.2" stroke-linecap="round"/><circle cx="14" cy="21" r="2.4" fill="#faf6f1"/><circle cx="26" cy="21" r="2.4" fill="#faf6f1"/><circle cx="31" cy="9" r="4" fill="#f2b8c8"/></svg>
      <h1 class="mt-3 font-display text-2xl font-bold">ورود به پنل مدیریت</h1>
      <p class="text-xs text-ink-500">فقط برای کارکنان کیدل</p>
    </div>
    <% if (error === 'expired') { %><div class="alert alert-info mb-3">نشست شما به‌دلیل عدم فعالیت پایان یافت. دوباره وارد شوید.</div><% } %>
    <% if (error === 'account_disabled') { %><div class="alert alert-danger mb-3">حساب شما غیرفعال شده است.</div><% } %>
    <form id="login" class="space-y-3" novalidate>
      <div class="field"><label class="label" for="email">ایمیل</label><input class="input ltr" id="email" name="email" type="email" autocomplete="username" required autofocus></div>
      <div class="field"><label class="label" for="password">رمز عبور</label><input class="input ltr" id="password" name="password" type="password" autocomplete="current-password" required></div>
      <p class="field-error" id="err" role="alert" hidden></p>
      <button class="btn btn-dark btn-lg btn-block"><span class="spinner"></span><span class="btn-label-idle">ورود</span></button>
    </form>
  </main>
  <div class="toast-region" id="toasts"></div>
  <script>window.KIDLE = {};</script>
  <script src="<%= asset('/js/app.js') %>"></script>
  <script>
    document.getElementById('login').addEventListener('submit', function (e) {
      e.preventDefault();
      var f = e.target, btn = f.querySelector('button'), err = document.getElementById('err');
      KIDLE.setLoading(btn, true); err.hidden = true;
      KIDLE.api('/admin/login', { method: 'POST', body: { email: f.email.value.trim(), password: f.password.value } })
        .then(function (d) { location.href = d.redirect || '/admin'; })
        .catch(function (x) { KIDLE.setLoading(btn, false); err.hidden = false; err.textContent = x.message; f.password.select(); });
    });
  </script>
</body>
</html>
