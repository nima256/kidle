<% locals.headerActions = '<button class="btn btn-primary btn-sm" data-edit="#cat-sheet" data-title="دسته‌بندی جدید" data-api-url="/admin/api/categories" data-api-method="POST" data-fill=\'' + json({ categoryType: type, isActive: true, color: '#ffe4ee' }).replace(/'/g, '&#39;') + '\'>' + icon('plus','icon-sm') + ' دسته جدید</button>'; %>
<%- include('_top') %>
<div class="mb-3 flex gap-2"><a class="chip <%= type === 'product' ? 'is-active' : '' %>" href="/admin/categories">دسته‌های محصول</a><a class="chip <%= type === 'weblog' ? 'is-active' : '' %>" href="/admin/categories?type=weblog">دسته‌های مجله</a></div>
<div class="card overflow-x-auto">
  <table class="table">
    <thead><tr><th>نام</th><th>تعداد</th><th>وضعیت</th><th><span class="sr-only">عملیات</span></th></tr></thead>
    <tbody>
      <% cats.forEach(function (c) { var fill = { name: c.name, categoryType: c.categoryType, parentId: c.parentId ? String(c.parentId) : '', description: c.description || '', metaDescription: c.metaDescription || '', icon: catIcon(c), color: c.color || '#ffffff', image: (c.images && c.images[0]) || '', isActive: c.isActive !== false }; %>
      <tr>
        <td><span style="padding-inline-start: <%= c.depth * 1.25 %>rem" class="flex items-center gap-2"><% if (c.depth) { %><span class="text-ink-300">└</span><% } %><span class="flex size-8 items-center justify-center rounded-md text-brand-700" style="background: <%= c.color || '#fff' %>"><%- icon(catIcon(c),'icon-sm') %></span><b class="font-medium"><%= c.name %></b></span></td>
        <td><%= fa(c.count) %></td>
        <td><span class="badge <%= c.isActive !== false ? 'badge-success' : 'badge-neutral' %>"><%= c.isActive !== false ? 'فعال' : 'غیرفعال' %></span></td>
        <td class="whitespace-nowrap text-end">
          <% if (c.categoryType === 'product') { %><a class="btn-icon size-8" href="/category/<%= c.slug %>" target="_blank" aria-label="مشاهده"><%- icon('eye','icon-sm') %></a><% } %>
          <button class="btn-icon size-8" data-edit="#cat-sheet" data-title="ویرایش دسته" data-api-url="/admin/api/categories/<%= c._id %>" data-api-method="PUT" data-fill="<%= JSON.stringify(fill) %>" aria-label="ویرایش"><%- icon('edit','icon-sm') %></button>
          <button class="btn-icon size-8 text-danger-600" data-action="/admin/api/categories/<%= c._id %>" data-method="DELETE" data-confirm="دسته «<%= c.name %>» حذف شود؟" aria-label="حذف"><%- icon('trash','icon-sm') %></button>
        </td>
      </tr>
      <% }) %>
      <% if (!cats.length) { %><tr><td colspan="4" class="py-8 text-center text-ink-500">هنوز دسته‌ای ساخته نشده است</td></tr><% } %>
    </tbody>
  </table>
</div>

<div class="overlay" id="cat-sheet" role="dialog" aria-modal="true" aria-labelledby="cat-t" hidden data-overlay>
  <form class="sheet sheet-lg" data-api="" data-reload novalidate>
    <div class="sheet-head"><h2 id="cat-t" class="sheet-title" data-sheet-title>دسته‌بندی</h2><button type="button" class="btn-icon" data-close-overlay aria-label="بستن"><%- icon('x') %></button></div>
    <div class="sheet-body grid gap-3 sm:grid-cols-2">
      <input type="hidden" name="categoryType">
      <div class="field"><label class="label" for="c-name">نام <span class="req">*</span></label><input class="input" id="c-name" name="name" maxlength="50"><p class="field-error" data-err="name" hidden></p></div>
      <div class="field"><label class="label" for="c-parent">زیرمجموعه‌ی</label><select class="select" id="c-parent" name="parentId"><option value="">— دسته اصلی —</option><% cats.forEach(function (c) { %><option value="<%= c._id %>"><%= '— '.repeat(c.depth) + c.name %></option><% }) %></select></div>
      <fieldset class="field sm:col-span-2"><legend class="label mb-1.5">آیکون کارت دسته</legend><div class="flex flex-wrap gap-2"><label class="opt !min-h-12 !px-2" title="پیراهن"><input type="radio" name="icon" value="c-dress"><%- icon('c-dress','size-6') %><span class="sr-only">پیراهن</span></label><label class="opt !min-h-12 !px-2" title="تیشرت"><input type="radio" name="icon" value="c-tshirt"><%- icon('c-tshirt','size-6') %><span class="sr-only">تیشرت</span></label><label class="opt !min-h-12 !px-2" title="نوزادی"><input type="radio" name="icon" value="c-onesie"><%- icon('c-onesie','size-6') %><span class="sr-only">نوزادی</span></label><label class="opt !min-h-12 !px-2" title="شلوار"><input type="radio" name="icon" value="c-pants"><%- icon('c-pants','size-6') %><span class="sr-only">شلوار</span></label><label class="opt !min-h-12 !px-2" title="جوراب"><input type="radio" name="icon" value="c-socks"><%- icon('c-socks','size-6') %><span class="sr-only">جوراب</span></label><label class="opt !min-h-12 !px-2" title="اکسسوری"><input type="radio" name="icon" value="c-bow"><%- icon('c-bow','size-6') %><span class="sr-only">اکسسوری</span></label><label class="opt !min-h-12 !px-2" title="کلاه"><input type="radio" name="icon" value="c-hat"><%- icon('c-hat','size-6') %><span class="sr-only">کلاه</span></label><label class="opt !min-h-12 !px-2" title="کفش"><input type="radio" name="icon" value="c-shoe"><%- icon('c-shoe','size-6') %><span class="sr-only">کفش</span></label><label class="opt !min-h-12 !px-2" title="ست"><input type="radio" name="icon" value="c-set"><%- icon('c-set','size-6') %><span class="sr-only">ست</span></label><label class="opt !min-h-12 !px-2" title="عمومی"><input type="radio" name="icon" value="hanger"><%- icon('hanger','size-6') %><span class="sr-only">عمومی</span></label></div><p class="hint">اگر تصویر آپلود کنید، تصویر به‌جای آیکون نمایش داده می‌شود.</p></fieldset>
      <div class="field"><label class="label" for="c-color">رنگ پس‌زمینه کارت</label><input type="color" class="h-11 w-full cursor-pointer rounded-md border border-ink-300" id="c-color" name="color"></div>
      <div class="field sm:col-span-2" data-uploader data-folder="category" data-single>
        <span class="label">تصویر کارت دسته (اختیاری)</span>
        <input type="hidden" name="image" data-single-value>
        <div class="flex gap-2" data-images="_catimg"></div>
        <label class="btn btn-secondary btn-sm mt-1 w-fit cursor-pointer"><%- icon('upload','icon-sm') %> انتخاب تصویر<input type="file" accept="image/*" class="sr-only"></label>
      </div>
      <div class="field sm:col-span-2"><label class="label" for="c-desc">توضیحات صفحه دسته</label><textarea class="textarea" id="c-desc" name="description" maxlength="3000"></textarea></div>
      <div class="field sm:col-span-2"><label class="label" for="c-meta">توضیحات متا (سئو)</label><input class="input" id="c-meta" name="metaDescription" maxlength="160"><p class="hint">حداکثر ۱۶۰ کاراکتر؛ در نتایج گوگل نمایش داده می‌شود.</p></div>
      <label class="f-check"><input class="check" type="checkbox" name="isActive"> فعال</label>
    </div>
    <div class="sheet-foot"><button class="btn btn-primary btn-block"><span class="spinner"></span><span class="btn-label-idle">ذخیره</span></button></div>
  </form>
</div>
<script>
  // Show the current category image when editing.
  document.addEventListener('change', function (e) {
    if (e.target.name !== 'image' || !e.target.hasAttribute('data-single-value')) return;
    var box = document.querySelector('[data-images="_catimg"]');
    box.innerHTML = e.target.value ? KIDLE.thumb(e.target.value, '', '', true) : '';
  });
</script>
<%- include('_bottom') %>
