<% var w = post, isNew = !w._id; locals.richEditor = true; var img0 = (w.images || [])[0]; var selc = (w.categories || []).map(String);
   locals.headerActions = '<button form="wf" class="btn btn-primary btn-sm"><span class="spinner"></span><span class="btn-label-idle">ذخیره</span></button>'; %>
<%- include('_top') %>
<form data-unsaved-warning id="wf" data-api="<%= isNew ? '/admin/api/weblogs' : '/admin/api/weblogs/' + w._id %>" data-method="<%= isNew ? 'POST' : 'PUT' %>" <%= isNew ? 'data-follow' : '' %> novalidate class="grid gap-4 xl:grid-cols-[1fr_20rem]">
  <div class="space-y-4">
    <section class="card card-pad space-y-3">
      <div class="field"><label class="label" for="t">عنوان <span class="req">*</span></label><input class="input" id="t" name="title" value="<%= w.title || '' %>" maxlength="100"><p class="field-error" data-err="title" hidden></p></div>
      <div class="field"><label class="label" for="d">خلاصه <span class="req">*</span></label><textarea class="textarea !min-h-16" id="d" name="description" maxlength="160"><%= w.description || '' %></textarea><p class="field-error" data-err="description" hidden></p></div>
      <div class="field"><span class="label">متن مقاله <span class="req">*</span></span><div data-rich="content" class="rounded-md bg-surface"><template><%- w.content || '' %></template></div><p class="field-error" data-err="content" hidden></p></div>
    </section>
  </div>
  <div class="space-y-4">
    <section class="card card-pad space-y-2">
      <label class="f-check"><input class="check" type="checkbox" name="isPublished" <%= w.isPublished ? 'checked' : '' %>> منتشر شود</label>
      <label class="f-check"><input class="check" type="checkbox" name="isFeatured" <%= w.isFeatured ? 'checked' : '' %>> مقاله ویژه</label>
    </section>
    <section class="card card-pad" data-uploader data-folder="weblog" data-single>
      <h2 class="mb-2 text-sm font-bold">تصویر شاخص</h2>
      <input type="hidden" name="image" data-single-value value="<%= img0 ? img0.url : '' %>">
      <div class="flex gap-2" data-images="_cover"><% if (img0) { %><div class="relative w-28 overflow-hidden rounded-md border border-ink-200" data-image data-url="<%= img0.url %>" data-filename="<%= img0.filename %>"><img src="<%= img0.url %>" alt="" class="aspect-[4/5] w-full object-cover"><div class="absolute top-1 start-1"><button type="button" class="rounded bg-surface/90 px-1 text-danger-600" data-img-remove aria-label="حذف تصویر"><%- icon('x','icon-sm') %></button></div></div><% } %></div>
      <label class="btn btn-secondary btn-sm mt-2 cursor-pointer"><%- icon('upload','icon-sm') %> انتخاب تصویر<input type="file" accept="image/*" class="sr-only"></label>
      <div class="field mt-2"><label class="label" for="cap">زیرنویس تصویر</label><input class="input" id="cap" name="imageCaption" value="<%= img0 && img0.caption || '' %>"></div>
    </section>
    <section class="card card-pad">
      <h2 class="mb-2 text-sm font-bold">دسته‌ها</h2>
      <% cats.forEach(function (c) { %><label class="f-check"><input class="check" type="checkbox" name="categories[]" value="<%= c._id %>" <%= selc.indexOf(String(c._id)) !== -1 ? 'checked' : '' %>> <%= c.name %></label><% }) %>
      <% if (!cats.length) { %><p class="text-xs text-ink-500">ابتدا از بخش دسته‌بندی‌ها، دسته مجله بسازید.</p><% } %>
    </section>
    <section class="card card-pad space-y-3">
      <h2 class="text-sm font-bold">سئو</h2>
      <div class="field"><label class="label" for="mt">عنوان متا</label><input class="input" id="mt" name="metaTitle" maxlength="60" value="<%= w.metaTitle || '' %>"></div>
      <div class="field"><label class="label" for="md">توضیحات متا</label><textarea class="textarea !min-h-16" id="md" name="metaDescription" maxlength="160"><%= w.metaDescription || '' %></textarea></div>
      <div class="field"><label class="label" for="tg">برچسب‌ها</label><input class="input" id="tg" name="tags" value="<%= (w.tags || []).join('، ') %>"></div>
      <div class="field"><label class="label" for="rt">زمان مطالعه (دقیقه)</label><input class="input ltr" id="rt" name="readingTime" inputmode="numeric" value="<%= w.readingTime || '' %>" placeholder="خودکار"></div>
    </section>
  </div>
</form>
<%- include('_bottom') %>
