<% locals.headerActions = '<button class="btn btn-primary btn-sm" data-edit="#ad-sheet" data-title="مدیر جدید" data-api-url="/admin/api/admins" data-api-method="POST" data-fill=\'{"role":"admin","isActive":true}\'>' + icon('plus','icon-sm') + ' مدیر جدید</button>'; %>
<%- include('_top') %>
<div class="alert alert-info mb-3"><%- icon('shield','icon-sm mt-0.5') %><span>هر مدیر فقط به بخش‌هایی که برایش فعال شده دسترسی دارد و این محدودیت روی سرور اعمال می‌شود. شما نمی‌توانید دسترسی‌ای بدهید که خودتان ندارید.</span></div>
<div class="card overflow-x-auto">
  <table class="table"><thead><tr><th>مدیر</th><th>نقش و دسترسی</th><th>آخرین ورود</th><th>وضعیت</th><th><span class="sr-only">عملیات</span></th></tr></thead><tbody>
    <% admins.forEach(function (a) { var fill = { fullName: a.fullName, email: a.email, role: a.role, permissions: a.permissions || [], isActive: a.isActive !== false }; %>
    <tr><td><b><%= a.fullName %></b><span class="ltr block text-xs text-ink-500"><%= a.email %></span></td>
      <td class="max-w-md text-xs"><% if (a.role === 'super_admin') { %><span class="badge badge-sale">مدیر ارشد — همه دسترسی‌ها</span><% } else { %><%= (a.permissions || []).map(function (p) { return PERMISSIONS[p] || p; }).join('، ') || 'بدون دسترسی' %><% } %></td>
      <td class="text-xs text-ink-500"><%= a.lastLoginAt ? faDate(a.lastLoginAt, { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : '—' %></td>
      <td><span class="badge <%= a.isActive !== false ? 'badge-success' : 'badge-neutral' %>"><%= a.isActive !== false ? 'فعال' : 'غیرفعال' %></span><% if (a.lockUntil && new Date(a.lockUntil) > new Date()) { %> <span class="badge badge-danger">قفل موقت</span><% } %></td>
      <td class="text-end"><button class="btn-icon size-8" data-edit="#ad-sheet" data-title="ویرایش مدیر" data-api-url="/admin/api/admins/<%= a._id %>" data-api-method="PUT" data-fill="<%= JSON.stringify(fill) %>" aria-label="ویرایش"><%- icon('edit','icon-sm') %></button></td></tr>
    <% }) %>
  </tbody></table>
</div>
<div class="overlay" id="ad-sheet" role="dialog" aria-modal="true" aria-labelledby="ad-t" hidden data-overlay>
  <form class="sheet sheet-lg" data-api="" data-reload novalidate>
    <div class="sheet-head"><h2 id="ad-t" class="sheet-title" data-sheet-title>مدیر</h2><button type="button" class="btn-icon" data-close-overlay aria-label="بستن"><%- icon('x') %></button></div>
    <div class="sheet-body space-y-3">
      <div class="grid gap-3 sm:grid-cols-2">
        <div class="field"><label class="label" for="a-name">نام <span class="req">*</span></label><input class="input" id="a-name" name="fullName"><p class="field-error" data-err="fullName" hidden></p></div>
        <div class="field"><label class="label" for="a-email">ایمیل <span class="req">*</span></label><input class="input ltr" id="a-email" name="email" type="email"><p class="field-error" data-err="email" hidden></p></div>
        <div class="field"><label class="label" for="a-pass">رمز عبور</label><input class="input ltr" id="a-pass" name="password" type="password" autocomplete="new-password" placeholder="برای ویرایش، خالی = بدون تغییر"><p class="field-error" data-err="password" hidden></p><p class="hint">حداقل ۱۰ کاراکتر شامل حرف و عدد</p></div>
        <div class="field"><label class="label" for="a-role">نقش</label><select class="select" id="a-role" name="role"><option value="admin">مدیر (دسترسی محدود)</option><% if (admin.role === 'super_admin') { %><option value="super_admin">مدیر ارشد (همه دسترسی‌ها)</option><% } %></select></div>
      </div>
      <fieldset data-perms>
        <legend class="label mb-1">دسترسی‌ها</legend>
        <div class="mb-2 flex flex-wrap gap-1.5"><span class="text-xs text-ink-500">الگوها:</span><% Object.keys(ROLE_PRESETS).forEach(function (k) { %><button type="button" class="chip h-7 text-xs" data-preset="<%= ROLE_PRESETS[k].permissions.join(',') %>"><%= ROLE_PRESETS[k].label %></button><% }) %></div>
        <div class="grid gap-x-3 sm:grid-cols-2">
          <% Object.keys(PERMISSIONS).filter(function (p) { return p !== 'view_analytics'; }).forEach(function (p) { %><label class="f-check"><input class="check" type="checkbox" name="permissions[]" value="<%= p %>" <%= can(p) ? '' : 'disabled' %>> <%= PERMISSIONS[p] %></label><% }) %>
        </div>
      </fieldset>
      <label class="f-check"><input class="check" type="checkbox" name="isActive"> حساب فعال است</label>
    </div>
    <div class="sheet-foot"><button class="btn btn-primary btn-block"><span class="spinner"></span><span class="btn-label-idle">ذخیره</span></button></div>
  </form>
</div>
<script>
  document.addEventListener('click', function (e) {
    var b = e.target.closest('[data-preset]'); if (!b) return;
    var set = b.getAttribute('data-preset').split(',');
    document.querySelectorAll('#ad-sheet [name="permissions[]"]').forEach(function (c) { if (!c.disabled) c.checked = set.indexOf(c.value) !== -1; });
  });
  document.addEventListener('change', function (e) {
    if (e.target.id !== 'a-role') return;
    document.querySelector('[data-perms]').hidden = e.target.value === 'super_admin';
  });
</script>
<%- include('_bottom') %>
