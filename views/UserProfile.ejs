      <!-- آیکون‌ها و همبرگر -->
    <div class="flex items-center space-x-4 space-x-reverse order-1 md:order-3">
      <div class="relative">
        <button class="relative text-gray-700 hover:text-pink-500 transition-colors">
          <a href="/cart">
            <i class="fas fa-shopping-bag text-xl"></i>
          </a>
          <% if(user) { %>
            <span id="cartCount" class="absolute cart-count bg-pink-500 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center">
